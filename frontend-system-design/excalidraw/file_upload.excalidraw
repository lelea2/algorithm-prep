    {
      "id": "_ZFvVCP0rkP1RaITir4mC",
      "type": "text",
      "x": -20.59302746222852,
      "y": 5807.89248249172,
      "width": 374.8797607421875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
