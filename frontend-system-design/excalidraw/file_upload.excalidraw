      "isDeleted": false,
      "boundElements": null,
      "updated": 1791571784653,
      "created": 1791571660732,
      "link": null,
      "locked": false,
      "text": "POST /api/uploads ==> upload session\nGET /api/uploads/:id\nPOST /api/upload/:id/complete => finalize upload object\nDELETE /api/upload/:id => abort sesion\n\nGET /api/documents => document repository\nGET /api/document/:id\nDELETE /api/document/:id\n\nPOST /api/document/:id/process ==> request processing\nPOST /api/processing/events => stream authorized processing events\n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /api/uploads ==> upload session\nGET /api/uploads/:id\nPOST /api/upload/:id/complete => finalize upload object\nDELETE /api/upload/:id => abort sesion\n\nGET /api/documents => document repository\nGET /api/document/:id\nDELETE /api/document/:id\n\nPOST /api/document/:id/process ==> request processing\nPOST /api/processing/events => stream authorized processing events\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
