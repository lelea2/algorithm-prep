    {
      "id": "TFCABpBCF0Iig0OeOpkvy",
      "type": "text",
      "x": 625.0623487023252,
      "y": 257.72367345668874,
      "width": 504.39931358868535,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1169566891,
      "version": 642,
      "versionNonce": 372869035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791571423170,
      "created": 1791570315964,
      "link": null,
      "locked": false,
      "text": "* Performance (~100 active pending files)\n- file validation < 100ms\n- interaction latency INP < 200ms\n- upload ~100-300ms\n- scrolling (aiming for 60FPS)\n* Concurrency (limit upload 3 active transfer)\n* reliability (recovery from network failure)\n* persistence/accessibility/scalability\n* consistency/memory (avoid loading too large file\nin JS memory)\n* responsiveness (desktop/tablet/mobile)\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Performance (~100 active pending files)\n- file validation < 100ms\n- interaction latency INP < 200ms\n- upload ~100-300ms\n- scrolling (aiming for 60FPS)\n* Concurrency (limit upload 3 active transfer)\n* reliability (recovery from network failure)\n* persistence/accessibility/scalability\n* consistency/memory (avoid loading too large file in JS memory)\n* responsiveness (desktop/tablet/mobile)\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
