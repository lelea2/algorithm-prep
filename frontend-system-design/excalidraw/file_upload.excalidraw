      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572418238,
      "created": 1791572413853,
      "link": null,
      "locked": false,
      "text": "{\n  \"eventId\": \"evt-1009\",\n  \"documentId\": \"doc-789\",\n  \"jobId\": \"job-123\",\n  \"version\": 7,\n  \"stage\": \"OCR\",\n  \"status\": \"RUNNING\",\n  \"progressPercent\": 62,\n  \"timestamp\": \"2026-10-09T19:30:00Z\"\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
