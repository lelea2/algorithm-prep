    {
      "id": "-f1qZdIOUnOKwG65KKKSN",
      "type": "text",
      "x": 1102.388948628994,
      "y": 3764.2656006583334,
      "width": 800,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
