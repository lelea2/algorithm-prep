    },
    {
      "id": "yQoNQ2j9_TsLvglW6Vd_z",
      "type": "text",
      "x": -10.730575655867483,
      "y": 638.63127970423,
      "width": 508.259765625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
