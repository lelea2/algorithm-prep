      "updated": 1791571161656,
      "created": 1791571037945,
      "link": null,
      "locked": false,
      "text": "* DocumentWorkspace: orchestration (selection, filters)\n* FileDropZone: drag/drop/file selection\n* UploadQueue: pending/active upload\n* Document Table: repository Listing\n* Processing status: BE pipeline status\n* Document Preview: secure PDF preview\n* UploadManager: handle upload lifecycle/transfer state\n* ProcessingEventManager: SSE + reconciliation\n* DocumentRepository: Sever-data abstraction",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* DocumentWorkspace: orchestration (selection, filters)\n* FileDropZone: drag/drop/file selection\n* UploadQueue: pending/active upload\n* Document Table: repository Listing\n* Processing status: BE pipeline status\n* Document Preview: secure PDF preview\n* UploadManager: handle upload lifecycle/transfer state\n* ProcessingEventManager: SSE + reconciliation\n* DocumentRepository: Sever-data abstraction",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
