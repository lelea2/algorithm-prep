      "seed": 1148723205,
      "version": 30,
      "versionNonce": 1961371813,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791573320240,
      "created": 1791573314861,
      "link": null,
      "locked": false,
      "text": "function UploadItem({\n  clientId\n}: {\n  clientId: string;\n}) {\n  const upload = useUploadTask(clientId);\n\n  return (\n    <div>\n      <span>{upload.fileName}</span>\n\n      <progress\n        value={upload.progressPercent}\n        max={100}\n      />\n    </div>\n  );\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function UploadItem({\n  clientId\n}: {\n  clientId: string;\n}) {\n  const upload = useUploadTask(clientId);\n\n  return (\n    <div>\n      <span>{upload.fileName}</span>\n\n      <progress\n        value={upload.progressPercent}\n        max={100}\n      />\n    </div>\n  );\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
