      "text": "Event A: document version 10 -> INDEXING\nEvent B: document version 9  -> OCR",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event A: document version 10 -> INDEXING\nEvent B: document version 9  -> OCR",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "XN5Xl2a2XsJf0Nla55ZEG",
      "type": "text",
      "x": 1540.5212435765325,
      "y": 3291.3635676302197,
      "width": 315.05572509765625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 670017515,
      "version": 40,
      "versionNonce": 2119568267,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572503434,
      "created": 1791572496597,
      "link": null,
      "locked": false,
      "text": "function applyProcessingEvent(\n  current: DocumentRecord,\n  event: ProcessingEvent\n): DocumentRecord {\n  if (event.version <= current.version) {\n    return current;\n  }\n\n  return {\n    ...current,\n    status: mapProcessingStatus(event),\n    version: event.version,\n    updatedAt: event.timestamp\n  };\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function applyProcessingEvent(\n  current: DocumentRecord,\n  event: ProcessingEvent\n): DocumentRecord {\n  if (event.version <= current.version) {\n    return current;\n  }\n\n  return {\n    ...current,\n    status: mapProcessingStatus(event),\n    version: event.version,\n    updatedAt: event.timestamp\n  };\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
