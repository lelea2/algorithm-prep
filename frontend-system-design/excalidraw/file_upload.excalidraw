    {
      "id": "7dP1nkdFaUzsJ6Z7CWkWH",
      "type": "text",
      "x": -8.318263827947249,
      "y": 3796.179228941668,
      "width": 542.8634643554688,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 116685637,
      "version": 231,
      "versionNonce": 1170832139,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572973215,
      "created": 1791572917763,
      "link": null,
      "locked": false,
      "text": "- Consider user refresh page on upload progress (upload not finished)\n- Processing should continue because it's owned by BE\n- After refresh:\n\n1. Frontend fetches document records.\n2. Backend returns documents with active processing jobs.\n3. Frontend renders current statuses.\n4. SSE reconnects.\n5. Client receives new events.\n6. Client reconciles missing events through API refresh.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Consider user refresh page on upload progress (upload not finished)\n- Processing should continue because it's owned by BE\n- After refresh:\n\n1. Frontend fetches document records.\n2. Backend returns documents with active processing jobs.\n3. Frontend renders current statuses.\n4. SSE reconnects.\n5. Client receives new events.\n6. Client reconciles missing events through API refresh.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Jvt8_dwADtuTSny1t3NL6",
      "type": "text",
      "x": 671.1919190282682,
      "y": 3711.8253663899427,
      "width": 312.55975341796875,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 281653995,
      "version": 27,
      "versionNonce": 1236450245,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572985263,
      "created": 1791572981846,
      "link": null,
      "locked": false,
      "text": "Browser Refresh\n      |\n      v\nGET /api/documents?status=processing\n      |\n      v\nRehydrate Document Query Cache\n      |\n      v\nConnect SSE\n      |\n      v\nReceive Processing Events\n      |\n      v\nRefresh Missing / Stale Records\n      |\n      v\nConsistent UI",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Browser Refresh\n      |\n      v\nGET /api/documents?status=processing\n      |\n      v\nRehydrate Document Query Cache\n      |\n      v\nConnect SSE\n      |\n      v\nReceive Processing Events\n      |\n      v\nRefresh Missing / Stale Records\n      |\n      v\nConsistent UI",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
