    {
      "id": "E9lT0EXRO4OwUSCHTkZpQ",
      "type": "text",
      "x": -18.651591169011567,
      "y": 2937.287392878179,
      "width": 495.61968994140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 179173445,
      "version": 55,
      "versionNonce": 830063237,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572259531,
      "created": 1791572250140,
      "link": null,
      "locked": false,
      "text": "1) Upload manager need to handle with concurrency",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Upload manager need to handle with concurrency",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "3bdcGofdkUNb3uBoF1yVG",
      "type": "text",
      "x": -9.611499005318706,
      "y": 2957.5972173100536,
      "width": 800,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 2132391077,
      "version": 43,
      "versionNonce": 980726053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572275412,
      "created": 1791572260556,
      "link": null,
      "locked": false,
      "text": "\nUnlimited upload concurrency can:\n* Saturate the client’s connection capacity.\n* Compete with document metadata requests.\n* Increase memory and network pressure.\n* Reduce responsiveness on mobile devices.\n* Make retries harder to coordinate.\n\nA configurable concurrency limit of 2–4 is a reasonable starting point.\nFor very large files, multipart uploads may need separate per-file and global part-\nconcurrency limits.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nUnlimited upload concurrency can:\n* Saturate the client’s connection capacity.\n* Compete with document metadata requests.\n* Increase memory and network pressure.\n* Reduce responsiveness on mobile devices.\n* Make retries harder to coordinate.\n\nA configurable concurrency limit of 2–4 is a reasonable starting point.\nFor very large files, multipart uploads may need separate per-file and global part-concurrency limits.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Qm0TxrvG4uHaPYImiIX8A",
      "type": "text",
      "x": 1039.4158689996498,
      "y": 2918.001239689246,
      "width": 566.3995361328125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 255138699,
      "version": 180,
      "versionNonce": 1119165413,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791572306404,
      "created": 1791572285962,
      "link": null,
      "locked": false,
      "text": "2) Processing Event & status synchronization (with SSE)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Processing Event & status synchronization (with SSE)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eJE0nmHUa8S-Hcd2vR6c3",
      "type": "text",
      "x": 1044.0921080269788,
      "y": 2960.4896429431024,
      "width": 219.5198516845703,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
      "roundness": null,
      "seed": 663897291,
      "version": 25,
      "versionNonce": 94983403,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572404741,
      "created": 1791572390910,
      "link": null,
      "locked": false,
      "text": "interface ProcessingEvent {\n  eventId: string;\n\n  documentId: string;\n  jobId: string;\n\n  version: number;\n\n  stage: ProcessingStage;\n\n  status:\n    | \"PENDING\"\n    | \"RUNNING\"\n    | \"COMPLETED\"\n    | \"FAILED\";\n\n  progressPercent?: number;\n\n  timestamp: string;\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface ProcessingEvent {\n  eventId: string;\n\n  documentId: string;\n  jobId: string;\n\n  version: number;\n\n  stage: ProcessingStage;\n\n  status:\n    | \"PENDING\"\n    | \"RUNNING\"\n    | \"COMPLETED\"\n    | \"FAILED\";\n\n  progressPercent?: number;\n\n  timestamp: string;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "n2TV2sMlNcnx_R14W1qF4",
