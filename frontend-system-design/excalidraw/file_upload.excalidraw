    {
      "id": "wqvPFrSOltzxzTNgPtDST",
      "type": "text",
      "x": 1999.6896310124198,
      "y": 2483.7683121697346,
      "width": 682.6996459960938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
