      "seed": 692992171,
      "version": 64,
      "versionNonce": 823705701,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791573066150,
      "created": 1791573030575,
      "link": null,
      "locked": false,
      "text": "*** Why use both SSE and fetch *** \n\n- Because SSE is a stream of changes, not necessarily a complete state snapshot.\n- A client that only subscribes to future events may miss a completed job.\n- Use a consistent snapshot-and-stream protocol. For example, capture a server event cursor with\nthe initial snapshot and replay events after that cursor. If replay is unavailable, connect and reconcile\nwith an authoritative API refetch, using document versions to reject stale events.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Why use both SSE and fetch *** \n\n- Because SSE is a stream of changes, not necessarily a complete state snapshot.\n- A client that only subscribes to future events may miss a completed job.\n- Use a consistent snapshot-and-stream protocol. For example, capture a server event cursor with the initial snapshot and replay events after that cursor. If replay is unavailable, connect and reconcile with an authoritative API refetch, using document versions to reject stale events.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
