    {
      "id": "vkB2ioXQQ3-pjeIaPe8wu",
      "type": "text",
      "x": -8.97520742207962,
      "y": 4471.004726282546,
      "width": 328.91168212890625,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
