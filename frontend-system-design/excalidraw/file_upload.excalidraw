      "text": "* Subscribe per upload item.\n* Throttle visual progress updates.\n* Batch related store notifications.\n* Avoid recreating expensive file metadata structures.\n* Avoid recalculating batch totals on every render.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Subscribe per upload item.\n* Throttle visual progress updates.\n* Batch related store notifications.\n* Avoid recreating expensive file metadata structures.\n* Avoid recalculating batch totals on every render.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
