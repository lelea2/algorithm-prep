    {
      "id": "IbHSM-XscxL9bfxTeJ-WV",
      "type": "text",
      "x": -2.3884834914446174,
      "y": 3325.94015679497,
      "width": 521.151611328125,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 1373644267,
      "version": 79,
      "versionNonce": 1145102283,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791572895074,
      "created": 1791572792503,
      "link": null,
      "locked": false,
      "text": "Split file into chunk, on reconnection, upload only the missing parts\n\nUpload Manager\n      |\n      v\nMultipart Coordinator\n      |\n      +------> Chunk 1 -----> Storage\n      |\n      +------> Chunk 2 -----> Storage\n      |\n      +------> Chunk 3 -----> Storage\n      |\n      v\nCompleted Part Manifest\n      |\n      v\nFinalize Multipart Upload",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Split file into chunk, on reconnection, upload only the missing parts\n\nUpload Manager\n      |\n      v\nMultipart Coordinator\n      |\n      +------> Chunk 1 -----> Storage\n      |\n      +------> Chunk 2 -----> Storage\n      |\n      +------> Chunk 3 -----> Storage\n      |\n      v\nCompleted Part Manifest\n      |\n      v\nFinalize Multipart Upload",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
