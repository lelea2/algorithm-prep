      "boundElements": null,
      "updated": 1791571431650,
      "created": 1791571301633,
      "link": null,
      "locked": false,
      "text": "*** Data Model *** (Server vs Client owned domain)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Data Model *** (Server vs Client owned domain)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cEacR-JETBbdJymbrE_Xv",
      "type": "text",
      "x": -8.304615039033933,
      "y": 733.0193774609263,
      "width": 276.2997741699219,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 1037932613,
      "version": 196,
      "versionNonce": 395952869,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791571434865,
      "created": 1791571341314,
      "link": null,
      "locked": false,
      "text": "*** Sharable interface\n\ntype DocumentStatus =\n  | \"UPLOADING\"\n  | \"UPLOADED\"\n  | \"QUEUED\"\n  | \"SCANNING\"\n  | \"EXTRACTING\"\n  | \"OCR\"\n  | \"INDEXING\"\n  | \"READY\"\n  | \"FAILED\";\n\ninterface DocumentRecord {\n  id: string;\n\n  name: string;\n  mimeType: string;\n  sizeBytes: number;\n\n  ownerId: string;\n  workspaceId: string;\n\n  status: DocumentStatus;\n\n  version: number;\n  createdAt: string;\n  updatedAt: string;\n\n  processingJobId?: string;\n\n  error?: {\n    code: string;\n    message: string;\n    retryable: boolean;\n  };\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Sharable interface\n\ntype DocumentStatus =\n  | \"UPLOADING\"\n  | \"UPLOADED\"\n  | \"QUEUED\"\n  | \"SCANNING\"\n  | \"EXTRACTING\"\n  | \"OCR\"\n  | \"INDEXING\"\n  | \"READY\"\n  | \"FAILED\";\n\ninterface DocumentRecord {\n  id: string;\n\n  name: string;\n  mimeType: string;\n  sizeBytes: number;\n\n  ownerId: string;\n  workspaceId: string;\n\n  status: DocumentStatus;\n\n  version: number;\n  createdAt: string;\n  updatedAt: string;\n\n  processingJobId?: string;\n\n  error?: {\n    code: string;\n    message: string;\n    retryable: boolean;\n  };\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UzTYe0WxE2z6iQhs6QNF7",
      "type": "text",
      "x": 372.8843797640434,
      "y": 732.3649757531101,
      "width": 344.35980224609375,
      "height": 950,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b06",
      "roundness": null,
      "seed": 1871717285,
      "version": 83,
      "versionNonce": 2075232805,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791571437467,
      "created": 1791571373312,
      "link": null,
      "locked": false,
      "text": "*** Client upload model\n\ntype UploadStatus =\n  | \"QUEUED\"\n  | \"INITIALIZING\"\n  | \"UPLOADING\"\n  | \"PAUSED\"\n  | \"RETRYING\"\n  | \"FINALIZING\"\n  | \"COMPLETED\"\n  | \"FAILED\"\n  | \"CANCELED\";\n\ninterface UploadTask {\n  clientId: string;\n\n  file: File;\n\n  fileName: string;\n  fileSize: number;\n\n  uploadId?: string;\n  documentId?: string;\n\n  status: UploadStatus;\n\n  bytesUploaded: number;\n  progressPercent: number;\n\n  attempt: number;\n\n  error?: {\n    code: string;\n    message: string;\n  };\n\n  abortController?: AbortController;\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Client upload model\n\ntype UploadStatus =\n  | \"QUEUED\"\n  | \"INITIALIZING\"\n  | \"UPLOADING\"\n  | \"PAUSED\"\n  | \"RETRYING\"\n  | \"FINALIZING\"\n  | \"COMPLETED\"\n  | \"FAILED\"\n  | \"CANCELED\";\n\ninterface UploadTask {\n  clientId: string;\n\n  file: File;\n\n  fileName: string;\n  fileSize: number;\n\n  uploadId?: string;\n  documentId?: string;\n\n  status: UploadStatus;\n\n  bytesUploaded: number;\n  progressPercent: number;\n\n  attempt: number;\n\n  error?: {\n    code: string;\n    message: string;\n  };\n\n  abortController?: AbortController;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KxzUxzA0srYZWJs37WzUZ",
      "type": "text",
      "x": 809.0524666195287,
      "y": 722.3432810276914,
      "width": 266.4997863769531,
      "height": 900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b07",
      "roundness": null,
      "seed": 709828677,
      "version": 29,
      "versionNonce": 380360389,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791571470028,
      "created": 1791571464362,
      "link": null,
      "locked": false,
      "text": "** Server processing job\n\ntype ProcessingStage =\n  | \"QUEUED\"\n  | \"VIRUS_SCAN\"\n  | \"TEXT_EXTRACTION\"\n  | \"OCR\"\n  | \"INDEXING\"\n  | \"COMPLETED\"\n  | \"FAILED\";\n\ninterface ProcessingJob {\n  jobId: string;\n  documentId: string;\n\n  stage: ProcessingStage;\n\n  status:\n    | \"PENDING\"\n    | \"RUNNING\"\n    | \"COMPLETED\"\n    | \"FAILED\";\n\n  progressPercent?: number;\n\n  startedAt?: string;\n  completedAt?: string;\n\n  version: number;\n\n  error?: {\n    code: string;\n    message: string;\n    retryable: boolean;\n  };\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** Server processing job\n\ntype ProcessingStage =\n  | \"QUEUED\"\n  | \"VIRUS_SCAN\"\n  | \"TEXT_EXTRACTION\"\n  | \"OCR\"\n  | \"INDEXING\"\n  | \"COMPLETED\"\n  | \"FAILED\";\n\ninterface ProcessingJob {\n  jobId: string;\n  documentId: string;\n\n  stage: ProcessingStage;\n\n  status:\n    | \"PENDING\"\n    | \"RUNNING\"\n    | \"COMPLETED\"\n    | \"FAILED\";\n\n  progressPercent?: number;\n\n  startedAt?: string;\n  completedAt?: string;\n\n  version: number;\n\n  error?: {\n    code: string;\n    message: string;\n    retryable: boolean;\n  };\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1gN8tVtRW14EmabgwAX62",
      "type": "rectangle",
      "x": -35.71469800071779,
      "y": 622.9359146931662,
      "width": 1227.8212042906018,
