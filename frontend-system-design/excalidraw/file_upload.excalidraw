    {
      "id": "v9Yuo5HiwmRq1tOA44eX_",
      "type": "text",
      "x": 1994.9031499495336,
      "y": 2145.269680205853,
      "width": 723.49951171875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 2099023429,
      "version": 5,
      "versionNonce": 1344189323,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791571246103,
      "created": 1791571237522,
      "link": null,
      "locked": false,
      "text": "1. User chooses files.\n2. Frontend validates metadata.\n3. Frontend adds valid files to the upload queue.\n4. Scheduler starts up to three uploads.\n5. Backend creates upload sessions.\n6. Browser uploads files directly to object storage.\n7. Browser finalizes the upload.\n8. Backend verifies the object and creates a processing job.\n9. Frontend subscribes to processing events.\n10. Processing workers update job statuses.\n11. UI updates the document records.\n12. On completion, the document becomes available for preview and search.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User chooses files.\n2. Frontend validates metadata.\n3. Frontend adds valid files to the upload queue.\n4. Scheduler starts up to three uploads.\n5. Backend creates upload sessions.\n6. Browser uploads files directly to object storage.\n7. Browser finalizes the upload.\n8. Backend verifies the object and creates a processing job.\n9. Frontend subscribes to processing events.\n10. Processing workers update job statuses.\n11. UI updates the document records.\n12. On completion, the document becomes available for preview and search.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-zUjia-YPEC_aAlJGeD7C",
