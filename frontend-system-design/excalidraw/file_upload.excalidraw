      "link": null,
      "locked": false,
      "text": "<DocumentWorkspace>\n  <WorkspaceToolbar />\n\n  <UploadDropZone />\n\n  <UploadPanel>\n    <UploadQueue>\n      <UploadItem>\n        <FileMetadata />\n        <UploadProgress />\n        <UploadActions />\n      </UploadItem>\n    </UploadQueue>\n  </UploadPanel>\n\n  <DocumentTable>\n    <DocumentRow>\n      <DocumentIcon />\n      <DocumentMetadata />\n      <ProcessingStatus />\n      <DocumentActions />\n    </DocumentRow>\n  </DocumentTable>\n\n  <DocumentPreviewDialog>\n    <PdfViewer />\n  </DocumentPreviewDialog>\n</DocumentWorkspace>",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<DocumentWorkspace>\n  <WorkspaceToolbar />\n\n  <UploadDropZone />\n\n  <UploadPanel>\n    <UploadQueue>\n      <UploadItem>\n        <FileMetadata />\n        <UploadProgress />\n        <UploadActions />\n      </UploadItem>\n    </UploadQueue>\n  </UploadPanel>\n\n  <DocumentTable>\n    <DocumentRow>\n      <DocumentIcon />\n      <DocumentMetadata />\n      <ProcessingStatus />\n      <DocumentActions />\n    </DocumentRow>\n  </DocumentTable>\n\n  <DocumentPreviewDialog>\n    <PdfViewer />\n  </DocumentPreviewDialog>\n</DocumentWorkspace>",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
