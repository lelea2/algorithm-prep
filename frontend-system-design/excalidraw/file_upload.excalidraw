    {
      "id": "yAca5FS-PiBJnARAatiRf",
      "type": "text",
      "x": -14.176127232558088,
      "y": 6105.2960404348105,
      "width": 800,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1C",
      "roundness": null,
      "seed": 1064812619,
      "version": 246,
      "versionNonce": 1830838347,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791574198312,
      "created": 1791574116174,
      "link": null,
      "locked": false,
      "text": "- Start with each tab independently fetch document states first (duplicate\nrequest and temporarily inconsistent UI)\n- EXtend to BroadcastChannel -0 use as hint for refetch\n\n// Tab A\nconst channel = new BroadcastChannel(\n  \"document-workspace\"\n);\n\nchannel.postMessage({\n  type: \"DOCUMENT_UPLOADED\",\n  documentId: \"doc-123\"\n});\n\n// Tab B\nchannel.onmessage = (event) => {\n  if (event.data.type === \"DOCUMENT_UPLOADED\") {\n    queryClient.invalidateQueries({\n      queryKey: [\"documents\"]\n    });\n  }\n};\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Start with each tab independently fetch document states first (duplicate request and temporarily inconsistent UI)\n- EXtend to BroadcastChannel -0 use as hint for refetch\n\n// Tab A\nconst channel = new BroadcastChannel(\n  \"document-workspace\"\n);\n\nchannel.postMessage({\n  type: \"DOCUMENT_UPLOADED\",\n  documentId: \"doc-123\"\n});\n\n// Tab B\nchannel.onmessage = (event) => {\n  if (event.data.type === \"DOCUMENT_UPLOADED\") {\n    queryClient.invalidateQueries({\n      queryKey: [\"documents\"]\n    });\n  }\n};\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
