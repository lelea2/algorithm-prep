    {
      "id": "aWTs23fi4x_tKNFboXsdg",
      "type": "text",
      "x": 448.4131259973093,
      "y": 4477.493125350192,
      "width": 800,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
