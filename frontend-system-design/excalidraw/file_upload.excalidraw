      "created": 1791570200783,
      "link": null,
      "locked": false,
      "text": "* File selection, drag/drop, file validation\n* multiple uploads\n* upload progress, processing status\n* Failure handler\n* Document listing, document preview\n* Cancel upload\n* Refresh recovery, pause/resume\n* Batch actions, search/filter by name, status\n* Notification (process/complete)\n* upload deduplication\n* document versioning, preprocessing",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
