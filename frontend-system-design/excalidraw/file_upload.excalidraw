      "isDeleted": false,
      "boundElements": null,
      "updated": 1791573359540,
      "created": 1791573339915,
      "link": null,
      "locked": false,
      "text": "*** Throttle UI progress updates ***\n\n- Network progress events may be much more frequent than necessary for a human-readable progress\nindicator.\n\n- The transport should continue tracking accurate bytes, while the rendering layer may publish\nupdates at 100–250 ms intervals.\n\n- This reduces rendering work without changing the underlying transfer behavior.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Throttle UI progress updates ***\n\n- Network progress events may be much more frequent than necessary for a human-readable progress indicator.\n\n- The transport should continue tracking accurate bytes, while the rendering layer may publish updates at 100–250 ms intervals.\n\n- This reduces rendering work without changing the underlying transfer behavior.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
