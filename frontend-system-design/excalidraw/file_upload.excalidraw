      "seed": 131388965,
      "version": 56,
      "versionNonce": 1150920459,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570559557,
      "created": 1791570546523,
      "link": null,
      "locked": false,
      "text": "1) Direct BE upload vs. object storage upload",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Direct BE upload vs. object storage upload",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5n4Gs2ELYIRgBcWsMC0p8",
      "type": "text",
      "x": 1237,
      "y": 255.5,
      "width": 317.8998107910156,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 184114923,
      "version": 4,
      "versionNonce": 1799463627,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570575771,
      "created": 1791570573143,
      "link": null,
      "locked": false,
      "text": "Browser\n   |\n   | 1. Create upload session\n   v\nApplication Backend\n   |\n   | 2. Return signed upload URL\n   v\nBrowser\n   |\n   | 3. Upload binary\n   v\nObject Storage\n   |\n   | 4. Commit upload\n   v\nApplication Backend",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Browser\n   |\n   | 1. Create upload session\n   v\nApplication Backend\n   |\n   | 2. Return signed upload URL\n   v\nBrowser\n   |\n   | 3. Upload binary\n   v\nObject Storage\n   |\n   | 4. Commit upload\n   v\nApplication Backend",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cCCLLd8KYijT7kQaGHt9F",
      "type": "text",
      "x": 1697,
      "y": 261.5,
      "width": 610.7595825195312,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1328411307,
      "version": 187,
      "versionNonce": 560208587,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570636031,
      "created": 1791570585007,
      "link": null,
      "locked": false,
      "text": "- BE bandwidth can become bottleneck for upload large file\n- If upload through BE, traffic could compete with other API,\nand expensive to scale\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- BE bandwidth can become bottleneck for upload large file\n- If upload through BE, traffic could compete with other API,\nand expensive to scale\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "of7yIxWrzvNZXa7KpFkY1",
      "type": "text",
      "x": 1676,
      "y": 360.5,
      "width": 468.37969970703125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 442694635,
      "version": 48,
      "versionNonce": 626948939,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570659677,
      "created": 1791570650350,
      "link": null,
      "locked": false,
      "text": "==> Choose Object storage upload (signed URL)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==> Choose Object storage upload (signed URL)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "OL4bTz9VUvcJL6NCiFodV",
      "type": "text",
      "x": 1680,
      "y": 398.5,
      "width": 570.5195922851562,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 765696811,
      "version": 6,
      "versionNonce": 565509605,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570666132,
      "created": 1791570661367,
      "link": null,
      "locked": false,
      "text": "Advantages\n* Application backend does not proxy file bytes.\n* Upload bandwidth scales with object storage.\n* Supports multipart uploads.\n* Separates metadata operations from binary transfers.\n\nDisadvantages\n* More complicated orchestration.\n* Signed URL lifecycle must be managed.\n* Browser needs to handle upload cancellation and retries.\n* Commit/finalization requires careful consistency checks.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Advantages\n* Application backend does not proxy file bytes.\n* Upload bandwidth scales with object storage.\n* Supports multipart uploads.\n* Separates metadata operations from binary transfers.\n\nDisadvantages\n* More complicated orchestration.\n* Signed URL lifecycle must be managed.\n* Browser needs to handle upload cancellation and retries.\n* Commit/finalization requires careful consistency checks.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ejCeT0s5BMBCk9H3eBEwI",
      "type": "text",
      "x": 1235.0492812163825,
      "y": 729.5230026220192,
      "width": 308.5798034667969,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 1827810309,
      "version": 33,
      "versionNonce": 1523570693,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570692891,
      "created": 1791570683925,
      "link": null,
      "locked": false,
      "text": "2) Polling vs SSE vs WebSocket",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Polling vs SSE vs WebSocket",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "X1zasKxtnDKcM8YPHyU7X",
      "type": "text",
      "x": 1236.245901482104,
      "y": 773.7979524537146,
      "width": 683.1395263671875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 106309291,
      "version": 109,
      "versionNonce": 1972220421,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570724966,
      "created": 1791570700778,
      "link": null,
      "locked": false,
      "text": "- The upload progress and processing progress are different problems.\n- Upload progress can be measure locally by browser\n- Processing must come from BE",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The upload progress and processing progress are different problems.\n- Upload progress can be measure locally by browser\n- Processing must come from BE",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "QDT4SScC-hptm1uZH-hLC",
      "type": "text",
      "x": 1237.4425217478256,
      "y": 862.3478521171053,
      "width": 644.859619140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 539612197,
      "version": 13,
      "versionNonce": 556819621,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570741088,
      "created": 1791570737070,
      "link": null,
      "locked": false,
      "text": "* Choose SSE for live processing events with polling as a fallback.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Choose SSE for live processing events with polling as a fallback.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "6bDh35YWE4p9D24zDdF1c",
      "type": "text",
      "x": 1247.0154838735975,
      "y": 895.8532195573073,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 1619921605,
      "version": 168,
      "versionNonce": 1970054757,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791570774548,
      "created": 1791570743600,
      "link": null,
      "locked": false,
      "text": "BE Processing Workers ==> Processing Event Bus ==> SSE endpoint ==> Browser\nclient ==> Document Status Store ==> React component",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BE Processing Workers ==> Processing Event Bus ==> SSE endpoint ==> Browser client ==> Document Status Store ==> React component",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "c83eEaZEsQRkr7sT7NfKa",
      "type": "text",
      "x": 1240.4053504027188,
      "y": 968.0991681002424,
      "width": 531.4996337890625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
