    {
      "id": "XPHfyZb7nMPA7hlqCro_4",
      "type": "text",
      "x": 1230,
      "y": 215.5,
      "width": 448.0797119140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
