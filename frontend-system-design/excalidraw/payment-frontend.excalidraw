      "seed": 1281991546,
      "version": 80,
      "versionNonce": 560920550,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789665716560,
      "created": 1789665620093,
      "link": null,
      "locked": false,
      "text": "1) Event pipeline ingestion -- should not directly call react setters",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Event pipeline ingestion -- should not directly call react setters",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gWsantafwQowWt_LK9oJJ",
      "type": "text",
      "x": -43.019761629946174,
      "y": 981.7264644609152,
      "width": 465.9396667480469,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 418716582,
      "version": 15,
      "versionNonce": 363943162,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789665658178,
      "created": 1789665647685,
      "link": null,
      "locked": false,
      "text": "At 1,000 events/sec this can trigger excessive:\n- allocations\n- scheduling\n- reconciliation\n- garbage collection",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At 1,000 events/sec this can trigger excessive:\n- allocations\n- scheduling\n- reconciliation\n- garbage collection",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JX9JCIWHVmpjGN_2tzaZP",
      "type": "text",
      "x": 720.653217998256,
      "y": 898.584648130425,
      "width": 197.2398681640625,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1236926266,
      "version": 4,
      "versionNonce": 1983465062,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789665669667,
      "created": 1789665666309,
      "link": null,
      "locked": false,
      "text": "SSE\n |\n v\nParser\n |\n v\nInput Queue\n |\n v\nDedupe\n |\n v\nCoalescer\n |\n v\nFrame / Time Batch\n |\n v\nStore Commit\n |\n v\nReact selectors",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SSE\n |\n v\nParser\n |\n v\nInput Queue\n |\n v\nDedupe\n |\n v\nCoalescer\n |\n v\nFrame / Time Batch\n |\n v\nStore Commit\n |\n v\nReact selectors",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NU7CGCbtEbswx7q3OyQ9L",
      "type": "text",
      "x": -44.04620380686583,
      "y": 1119.2697161681447,
      "width": 1219.3392333984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 1455138106,
      "version": 183,
      "versionNonce": 350842490,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789665711515,
      "created": 1789665674474,
      "link": null,
      "locked": false,
      "text": "Better: SSE -> Parser ==> input queue ==> dedup ==> coalescer ==> Frame/time batch ==> store commit ==> React Selectors\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Better: SSE -> Parser ==> input queue ==> dedup ==> coalescer ==> Frame/time batch ==> store commit ==> React Selectors\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UNiemnu8kK5TduJi599ex",
      "type": "text",
      "x": -38.68977221037483,
      "y": 1178.566799584021,
      "width": 251.89979553222656,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 1101449978,
      "version": 189,
      "versionNonce": 449455078,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789665730109,
      "created": 1789665717426,
      "link": null,
      "locked": false,
      "text": "2) Buffering and batching",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Buffering and batching",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "v4E0WNG1cwbvP5UXhxL7b",
      "type": "text",
      "x": -48.637126824728966,
      "y": 1199.5366924953087,
      "width": 1403.7391357421875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 1956511974,
      "version": 209,
      "versionNonce": 1508890470,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789665807236,
      "created": 1789665742889,
      "link": null,
      "locked": false,
      "text": "- Maintain an in-memory ingestion queue outside React, flush periodically (eg: 1000 networkcall ==> 20 stores commits/sec => flush every 50ms)\n\nconst FLUSH_MS = 50;\n\nsetInterval(() => {\n  if (!pendingEvents.length) return;\n\n  const batch = pendingEvents.splice(0, pendingEvents.length);\n  activityStore.applyBatch(batch);\n}, FLUSH_MS);",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Maintain an in-memory ingestion queue outside React, flush periodically (eg: 1000 networkcall ==> 20 stores commits/sec => flush every 50ms)\n\nconst FLUSH_MS = 50;\n\nsetInterval(() => {\n  if (!pendingEvents.length) return;\n\n  const batch = pendingEvents.splice(0, pendingEvents.length);\n  activityStore.applyBatch(batch);\n}, FLUSH_MS);",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Kv6a3Yn2ZW8_4U2jlwyKz",
      "type": "rectangle",
      "x": -64.13399797236309,
      "y": 1239.9470987200648,
      "width": 707.727871446329,
      "height": 248.57943610346115,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
