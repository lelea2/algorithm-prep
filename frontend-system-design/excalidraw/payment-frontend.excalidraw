      "created": 1789666141200,
      "link": null,
      "locked": false,
      "text": "Trade off:\n- serialization cost\n- extra architecture complexity\n- debugging overhead\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trade off:\n- serialization cost\n- extra architecture complexity\n- debugging overhead\n\n",
