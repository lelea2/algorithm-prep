      "link": null,
      "locked": false,
      "text": "Functional requirements\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-4TVNlYItM6PYAD8Dalxr",
      "type": "text",
      "x": -991,
      "y": 66,
      "width": 882.3994140625,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 211142394,
      "version": 43,
      "versionNonce": 1426976570,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789664823142,
      "created": 1789664800166,
      "link": null,
      "locked": false,
      "text": "1) View a continuously updating event stream.\n2) Inspect a payment, webhook, dispute, or refund.\n3) Filter by event type, payment status, webhook endpoint, failure status, and time range.\n4) Search by IDs such as pi_*, evt_*, re_*, and dp_*.\n5) Pause / resume live updates.\n6) Preserve scroll position while new events arrive.\n7 ) Show unread/new-event counts when the user is not at the top.\n8) Reconnect after transient network failures.\n9) Handle duplicate or out-of-order events.\n10) Work across multiple tabs.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) View a continuously updating event stream.\n2) Inspect a payment, webhook, dispute, or refund.\n3) Filter by event type, payment status, webhook endpoint, failure status, and time range.\n4) Search by IDs such as pi_*, evt_*, re_*, and dp_*.\n5) Pause / resume live updates.\n6) Preserve scroll position while new events arrive.\n7 ) Show unread/new-event counts when the user is not at the top.\n8) Reconnect after transient network failures.\n9) Handle duplicate or out-of-order events.\n10) Work across multiple tabs.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mYkWV8i40t-x0EVZyywCS",
      "type": "text",
      "x": -993.55859375,
      "y": 331.61328125,
      "width": 465.0997009277344,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 559198778,
      "version": 101,
      "versionNonce": 52794342,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789664861178,
      "created": 1789664827505,
      "link": null,
      "locked": false,
      "text": "Non-functional requirements:\n\n* Low INP and responsive interactions.\n* No full-list rerenders when one event changes.\n* Bounded memory.\n* Resilient to burst traffic.\n* Accessible.\n* Observable in production.\n* Reusable by multiple teams.\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirements:\n\n* Low INP and responsive interactions.\n* No full-list rerenders when one event changes.\n* Bounded memory.\n* Resilient to burst traffic.\n* Accessible.\n* Observable in production.\n* Reusable by multiple teams.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
