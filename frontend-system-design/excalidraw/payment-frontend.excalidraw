      "link": null,
      "locked": false
    },
    {
      "id": "tPf51sSDqjVrM5hRjXHhB",
      "type": "text",
      "x": 736.7314724101611,
      "y": 1266.748607384776,
      "width": 252.37982177734375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 475811942,
      "version": 222,
      "versionNonce": 1884801466,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789665862933,
      "created": 1789665823758,
      "link": null,
      "locked": false,
      "text": "** Smaller batches:\n- Fresher UI\n- More rendering overhead\n\n** Larger batches\n- Less rendering work\n- higher visible latency",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** Smaller batches:\n- Fresher UI\n- More rendering overhead\n\n** Larger batches\n- Less rendering work\n- higher visible latency",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pgQoD322QhSDWqavlTNJy",
      "type": "text",
      "x": 1488.3437564595574,
      "y": 33.65876110475671,
      "width": 467.5596923828125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1860741286,
      "version": 218,
      "versionNonce": 1167881786,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789665918643,
      "created": 1789665894941,
      "link": null,
      "locked": false,
      "text": "Entity state can be coalesced.\nAudit/event log entries may still need all events\nFor examples:\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entity state can be coalesced.\nAudit/event log entries may still need all events\nFor examples:\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "y5DB5FXl2-6YCfOX_Pxbf",
      "type": "text",
      "x": 1489.5786947036636,
      "y": 124.21421643963862,
      "width": 253.23980712890625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 767365926,
      "version": 41,
      "versionNonce": 1299642726,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789665920571,
      "created": 1789665903417,
      "link": null,
      "locked": false,
      "text": "Batch:\npi_1 -> processing v15\npi_2 -> pending    v2\npi_1 -> processing v16\npi_1 -> succeeded  v17\n\nCoalesced entity updates:\npi_1 -> succeeded v17\npi_2 -> pending   v2",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Batch:\npi_1 -> processing v15\npi_2 -> pending    v2\npi_1 -> processing v16\npi_1 -> succeeded  v17\n\nCoalesced entity updates:\npi_1 -> succeeded v17\npi_2 -> pending   v2",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GsTL0NIH--ktt_u7S4NQF",
      "type": "text",
      "x": -40.96687727610734,
      "y": 1522.6614916975577,
      "width": 278.4398193359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
