      "updated": 1789666128239,
      "created": 1789666107879,
      "link": null,
      "locked": false,
      "text": "Move CPU-heavy event processing off main thread if profiling justifies it.\n\n- large JSON transforms\n- expensive filtering\n- aggregation\n- sorting thousands of events\n- log parsing",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Move CPU-heavy event processing off main thread if profiling justifies it.\n\n- large JSON transforms\n- expensive filtering\n- aggregation\n- sorting thousands of events\n- log parsing",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
