    {
      "id": "0nILqr-CAHW7nhKwusMOG",
      "type": "text",
      "x": 1023.2592766748926,
      "y": -253.06812602800522,
      "width": 961.8199552007974,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
