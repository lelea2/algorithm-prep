    {
      "id": "lqKLMBBl3aEIcIIuarGZ-",
      "type": "text",
      "x": 679.8078706601204,
      "y": 2992.647789144631,
      "width": 495.5995178222656,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
