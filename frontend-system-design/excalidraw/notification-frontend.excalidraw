      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "tfJfHw6Q2-OZAB9UahV4L",
      "type": "text",
      "x": 162.27656769545877,
      "y": 2640.907206091507,
      "width": 315.6477355957031,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1C",
      "roundness": null,
      "seed": 103755065,
      "version": 25,
      "versionNonce": 1423397207,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789607371264,
      "created": 1789607340598,
      "link": null,
      "locked": false,
      "text": "CONNECTED\n    |  network loss\n    v\nDISCONNECTED\n    | exponential backoff + jitter\n    v\nRECONNECTING\n    | send lastSequence / Last-Event-ID\n    v\nCONNECTED",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CONNECTED\n    |  network loss\n    v\nDISCONNECTED\n    | exponential backoff + jitter\n    v\nRECONNECTING\n    | send lastSequence / Last-Event-ID\n    v\nCONNECTED",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ti-rAq-asFj8KjU0jfT28",
      "type": "text",
      "x": 158.65117909911856,
      "y": 2869.4199810545733,
      "width": 178.01583862304688,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
