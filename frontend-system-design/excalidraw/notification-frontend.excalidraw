    {
      "id": "v5GVsDYPjZ6utX6Sz8ylf",
      "type": "text",
      "x": 892.657274075024,
      "y": 1572.9081432579303,
      "width": 523.279541015625,
      "height": 680,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b12",
      "roundness": null,
      "seed": 1120609879,
      "version": 107,
      "versionNonce": 733043767,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789606896758,
      "created": 1789606855714,
      "link": null,
      "locked": false,
      "text": "function NotificationBell() {\n  const unreadCount = useNotificationStore((s) => s.unreadCount);\n\n  return (\n    <BellButton>\n      <NotificationIcon />\n      {unreadCount > 0 && <Badge>{unreadCount}</Badge>}\n    </BellButton>\n  );\n}\n\n\nfunction NotificationCenter() {\n  const ids = useNotificationStore(selectVisibleNotificationIds);\n\n  return <NotificationList ids={ids} />;\n}\n\nfunction NotificationRow({ id }: { id: string }) {\n  const notification = useNotificationStore((s) => s.byId[id]);\n\n  return <NotificationCard notification={notification} />;\n}\n\n\n// when n_123 changes\n\nstore.byId[n_123] changes\n       |\n       +--> row n_123 rerenders\n       |\n       +--> badge rerenders only if unreadCount changed\n\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function NotificationBell() {\n  const unreadCount = useNotificationStore((s) => s.unreadCount);\n\n  return (\n    <BellButton>\n      <NotificationIcon />\n      {unreadCount > 0 && <Badge>{unreadCount}</Badge>}\n    </BellButton>\n  );\n}\n\n\nfunction NotificationCenter() {\n  const ids = useNotificationStore(selectVisibleNotificationIds);\n\n  return <NotificationList ids={ids} />;\n}\n\nfunction NotificationRow({ id }: { id: string }) {\n  const notification = useNotificationStore((s) => s.byId[id]);\n\n  return <NotificationCard notification={notification} />;\n}\n\n\n// when n_123 changes\n\nstore.byId[n_123] changes\n       |\n       +--> row n_123 rerenders\n       |\n       +--> badge rerenders only if unreadCount changed\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
