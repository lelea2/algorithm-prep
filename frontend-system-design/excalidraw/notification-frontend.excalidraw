      "isDeleted": false,
      "boundElements": null,
      "updated": 1789607579660,
      "created": 1789607544378,
      "link": null,
      "locked": false,
      "text": "- high-priority notifications should bypass long batching delays:\n\nhigh priority -> process immediately\nnormal burst  -> batch within same task/frame",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- high-priority notifications should bypass long batching delays:\n\nhigh priority -> process immediately\nnormal burst  -> batch within same task/frame",
