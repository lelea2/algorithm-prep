      "link": null,
      "locked": false,
      "text": "*** Reconnect/Resume ***",
      "fontSize": 18.14974214423601,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Reconnect/Resume ***",
