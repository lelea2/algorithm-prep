    {
      "id": "ZcFiMFiFDJbl7kTQrXJdI",
      "type": "text",
      "x": -536.7421304871589,
      "y": 1271.081121994815,
      "width": 219.48779296875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 5905785,
      "version": 44,
      "versionNonce": 1146154103,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789605976075,
      "created": 1789605941640,
      "link": null,
      "locked": false,
      "text": "HTTP:\n- mark read\n- mark all read\n- perform required action\n- pagination\n- initial snapshot\n\nSSE\n- notification.created\n- notification.updated\n- notification.read\n- notification.resolved\n- notification.deleted\n- notification.count.updated",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP:\n- mark read\n- mark all read\n- perform required action\n- pagination\n- initial snapshot\n\nSSE\n- notification.created\n- notification.updated\n- notification.read\n- notification.resolved\n- notification.deleted\n- notification.count.updated",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
