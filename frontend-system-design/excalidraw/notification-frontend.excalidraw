      "isDeleted": false,
      "boundElements": null,
      "updated": 1789606580684,
      "created": 1789606542486,
      "link": null,
      "locked": false,
      "text": "\ntype NotificationEvent = {\n  eventId: string;\n  sequence: number;\n  type:\n    | 'notification.created'\n    | 'notification.updated'\n    | 'notification.read'\n    | 'notification.resolved'\n    | 'notification.deleted'\n    | 'notification.count.updated';\n\n  notification?: Notification;\n  notificationId?: string;\n\n  unreadCount?: number;\n  countVersion?: number;\n\n  occurredAt: string;\n};",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\ntype NotificationEvent = {\n  eventId: string;\n  sequence: number;\n  type:\n    | 'notification.created'\n    | 'notification.updated'\n    | 'notification.read'\n    | 'notification.resolved'\n    | 'notification.deleted'\n    | 'notification.count.updated';\n\n  notification?: Notification;\n  notificationId?: string;\n\n  unreadCount?: number;\n  countVersion?: number;\n\n  occurredAt: string;\n};",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
