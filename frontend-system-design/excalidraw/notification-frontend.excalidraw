      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Phone\n  |\n  | POST /notifications/n_1/read\n  v\nBackend\n  |\n  | persist authoritative state\n  |\n  +---- emit notification.read ----+\n  |                                |\n  v                                v\nPhone stream                    Laptop stream\n  |                                |\n  v                                v\nupdate store                    update store",
      "autoResize": true,
      "lineHeight": 1.25,
