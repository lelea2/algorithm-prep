      "link": null,
      "locked": false,
      "text": "<App>\n |\n +-- <NotificationProvider>\n |     +-- bootstrap snapshot\n |     +-- connection manager\n |     +-- repository\n |     +-- store\n |\n +-- <Navigation>\n |     +-- <NotificationBell>\n |           +-- <UnreadBadge>\n |\n +-- <NotificationCenter>\n |     +-- <NotificationHeader>\n |     +-- <VirtualizedNotificationList>\n |           +-- <NotificationRow id=...>\n |                 +-- <NotificationIcon>\n |                 +-- <NotificationContent>\n |                 +-- <NotificationActions>\n |\n +-- <NotificationToastHost>\n |\n +-- <PriorityNotificationHost>\n       +-- <RequiredActionModal / Banner>",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<App>\n |\n +-- <NotificationProvider>\n |     +-- bootstrap snapshot\n |     +-- connection manager\n |     +-- repository\n |     +-- store\n |\n +-- <Navigation>\n |     +-- <NotificationBell>\n |           +-- <UnreadBadge>\n |\n +-- <NotificationCenter>\n |     +-- <NotificationHeader>\n |     +-- <VirtualizedNotificationList>\n |           +-- <NotificationRow id=...>\n |                 +-- <NotificationIcon>\n |                 +-- <NotificationContent>\n |                 +-- <NotificationActions>\n |\n +-- <NotificationToastHost>\n |\n +-- <PriorityNotificationHost>\n       +-- <RequiredActionModal / Banner>",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
