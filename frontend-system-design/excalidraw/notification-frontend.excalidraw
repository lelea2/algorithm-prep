    {
      "id": "hse3utt-xEbtvyQ5DwT2B",
      "type": "text",
      "x": -537.7809263980425,
      "y": 1575.3225321914283,
      "width": 552.0155029296875,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
