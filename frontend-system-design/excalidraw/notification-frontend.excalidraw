    {
      "id": "duyBa9SB-c7FPnJj0cNIC",
      "type": "text",
      "x": -549.7514261523673,
      "y": 1827.9406549729495,
      "width": 255.0397491455078,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
