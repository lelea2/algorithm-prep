      "seed": 1397496409,
      "version": 165,
      "versionNonce": 1985434967,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789606034221,
      "created": 1789605997493,
      "link": null,
      "locked": false,
      "text": "** If product already has shared Websocket gateway, reuse it instead\n(eg: chat, party activity)\n\ninterface NotificationTransport {\n  connect(cursor?: string): Promise<void>;\n  disconnect(): void;\n  subscribe(handler: (event: NotificationEvent) => void): () => void;\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** If product already has shared Websocket gateway, reuse it instead\n(eg: chat, party activity)\n\ninterface NotificationTransport {\n  connect(cursor?: string): Promise<void>;\n  disconnect(): void;\n  subscribe(handler: (event: NotificationEvent) => void): () => void;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
