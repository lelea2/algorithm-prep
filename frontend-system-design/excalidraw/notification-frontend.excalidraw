    {
      "id": "mVuHY5MpRupF8nu8eTdPS",
      "type": "text",
      "x": -535.5207337325648,
      "y": 715.9989038954579,
      "width": 559.24755859375,
      "height": 460,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 1981150359,
      "version": 339,
      "versionNonce": 438407255,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789605899635,
      "created": 1789605780672,
      "link": null,
      "locked": false,
      "text": "GET /v1/notifications?limit=50\n{\n  \"notifications\": [],\n  \"nextCursor\": \"cursor_abc\",\n  \"unreadCount\": 12,\n  \"syncCursor\": \"evt_93842\",\n  \"countVersion\": 201\n}\nsyncCursor prevents race between initial fetch and open the live stream\n\n// Pagination\nGET /v1/notifications?cursor=cursor_abc&limit=50\n\n// Mark READ\nPOST /v1/notifications/:id/read\n\n// READ ALL\nPOST /v1/notifications/read-all\n\n// Resolve required action\nPOST /v1/notifications/:id/actions/:actionType\n==> Server validate the action. Client must to mark it resolved\nuntil confirmed.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GET /v1/notifications?limit=50\n{\n  \"notifications\": [],\n  \"nextCursor\": \"cursor_abc\",\n  \"unreadCount\": 12,\n  \"syncCursor\": \"evt_93842\",\n  \"countVersion\": 201\n}\nsyncCursor prevents race between initial fetch and open the live stream\n\n// Pagination\nGET /v1/notifications?cursor=cursor_abc&limit=50\n\n// Mark READ\nPOST /v1/notifications/:id/read\n\n// READ ALL\nPOST /v1/notifications/read-all\n\n// Resolve required action\nPOST /v1/notifications/:id/actions/:actionType\n==> Server validate the action. Client must to mark it resolved\nuntil confirmed.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
