    {
      "id": "lhOHT0M49Lwy269DVlfrg",
      "type": "text",
      "x": -556.4792527939522,
      "y": 2333.643547136584,
      "width": 517.617431640625,
      "height": 846.4686254563055,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 582090425,
      "version": 67,
      "versionNonce": 2144617623,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789606762465,
      "created": 1789606734046,
      "link": null,
      "locked": false,
      "text": "type NotificationId = string;\n\ntype Notification = {\n  id: NotificationId;\n  version: number;\n\n  type:\n    'friend_request' | 'experience_update' | 'favorite_update' | 'account' | 'security' | 'system';\n\n  priority: 'normal' | 'high';\n\n  title: string;\n  body: string;\n  imageUrl?: string;\n\n  createdAt: number;\n  updatedAt: number;\n  readAt: number | null;\n\n  deepLink?: string;\n\n  action?: {\n    type: string;\n    label: string;\n    payload?: Record<string, unknown>;\n  };\n\n  resolution: {\n    required: boolean;\n    resolvedAt: number | null;\n  };\n\n  presentation?: {\n    surface: 'center' | 'toast' | 'banner' | 'modal';\n  };\n};\n\n// Store shape\n\ntype NotificationState = {\n  byId: Record<NotificationId, Notification>;\n  orderedIds: NotificationId[];\n\n  unreadCount: number;\n  countVersion: number;\n\n  nextCursor?: string;\n\n  stream: {\n    connectionState: 'connecting' | 'connected' | 'disconnected';\n    lastSequence?: number;\n    syncCursor?: string;\n  };\n\n  ui: {\n    centerOpen: boolean;\n    activePriorityId?: string;\n  };\n};",
      "fontSize": 11.477540684153295,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type NotificationId = string;\n\ntype Notification = {\n  id: NotificationId;\n  version: number;\n\n  type:\n    'friend_request' | 'experience_update' | 'favorite_update' | 'account' | 'security' | 'system';\n\n  priority: 'normal' | 'high';\n\n  title: string;\n  body: string;\n  imageUrl?: string;\n\n  createdAt: number;\n  updatedAt: number;\n  readAt: number | null;\n\n  deepLink?: string;\n\n  action?: {\n    type: string;\n    label: string;\n    payload?: Record<string, unknown>;\n  };\n\n  resolution: {\n    required: boolean;\n    resolvedAt: number | null;\n  };\n\n  presentation?: {\n    surface: 'center' | 'toast' | 'banner' | 'modal';\n  };\n};\n\n// Store shape\n\ntype NotificationState = {\n  byId: Record<NotificationId, Notification>;\n  orderedIds: NotificationId[];\n\n  unreadCount: number;\n  countVersion: number;\n\n  nextCursor?: string;\n\n  stream: {\n    connectionState: 'connecting' | 'connected' | 'disconnected';\n    lastSequence?: number;\n    syncCursor?: string;\n  };\n\n  ui: {\n    centerOpen: boolean;\n    activePriorityId?: string;\n  };\n};",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
