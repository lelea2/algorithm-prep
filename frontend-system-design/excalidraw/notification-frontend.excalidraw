      "isDeleted": false,
      "boundElements": null,
      "updated": 1789607493029,
      "created": 1789607460597,
      "link": null,
      "locked": false,
      "text": "If cursor too old:\nserver: resync_required\n        |\n        v\nfetch new snapshot\n        |\n        v\nreplace/reconcile store\n        |\n        v\nresume stream",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If cursor too old:\nserver: resync_required\n        |\n        v\nfetch new snapshot\n        |\n        v\nreplace/reconcile store\n        |\n        v\nresume stream",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
