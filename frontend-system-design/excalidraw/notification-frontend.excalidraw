    {
      "id": "wpgQVkmISypUhg1QugKRk",
      "type": "text",
      "x": -476.49196765590017,
      "y": -4.686048262795225,
      "width": 570.3266107095501,
      "height": 297.3096809026722,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Y",
      "roundness": null,
      "seed": 2038329335,
      "version": 948,
      "versionNonce": 1498757977,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789605484262,
      "created": 1789605149224,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1) receive notifications in near real-time\n2) render global unread count\n3) Render notification center/history\n4) mark individual notification as read, mark all notification read\n5) High priority notification, required actions notifications\n6) Synchronize read/resolved state across decives\n7) Navigate to relevant expereince/profile/account surface\n\nNon-functional requirements\n1) Latency of real time ~1-2s\n2) avoid duplicated notifications\n3) preserve correctness across reconnects\n4) do not render whole application as 1 notification, support large history\n5) accessibility",
      "fontSize": 15.85651631480917,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1) receive notifications in near real-time\n2) render global unread count\n3) Render notification center/history\n4) mark individual notification as read, mark all notification read\n5) High priority notification, required actions notifications\n6) Synchronize read/resolved state across decives\n7) Navigate to relevant expereince/profile/account surface\n\nNon-functional requirements\n1) Latency of real time ~1-2s\n2) avoid duplicated notifications\n3) preserve correctness across reconnects\n4) do not render whole application as 1 notification, support large history\n5) accessibility",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
