      "text": ":root {\n  font-family: Inter, system-ui, sans-serif;\n}\n\nhtml,\nbody {\n  margin: 0;\n  min-height: 100%;\n  background: var(--color-bg-canvas);\n  color: var(--color-text-primary);\n}\n\nbody {\n  transition:\n    background-color 160ms ease,\n    color 160ms ease;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbutton,\ninput,\ntextarea,\nselect {\n  color: inherit;\n  font: inherit;\n}\n\n:focus-visible {\n  outline: 2px solid var(--color-focus-ring);\n  outline-offset: 2px;\n}\n\n:root[data-theme='light'] {\n  --color-focus-ring: #0a66c2;\n}\n\n:root[data-theme='dark'] {\n  --color-focus-ring: #8ab4f8;\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ":root {\n  font-family: Inter, system-ui, sans-serif;\n}\n\nhtml,\nbody {\n  margin: 0;\n  min-height: 100%;\n  background: var(--color-bg-canvas);\n  color: var(--color-text-primary);\n}\n\nbody {\n  transition:\n    background-color 160ms ease,\n    color 160ms ease;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbutton,\ninput,\ntextarea,\nselect {\n  color: inherit;\n  font: inherit;\n}\n\n:focus-visible {\n  outline: 2px solid var(--color-focus-ring);\n  outline-offset: 2px;\n}\n\n:root[data-theme='light'] {\n  --color-focus-ring: #0a66c2;\n}\n\n:root[data-theme='dark'] {\n  --color-focus-ring: #8ab4f8;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
