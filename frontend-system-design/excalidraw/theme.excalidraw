      "locked": false,
      "text": "4) Persistent strategy",
      "fontSize": 30.450695130289418,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4) Persistent strategy",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VvVw3lL5LrIVeUBmvQmgH",
      "type": "text",
      "x": 686.9939082873658,
      "y": 2639.596330886679,
      "width": 1054.279296875,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 788931552,
      "version": 330,
      "versionNonce": 952185376,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789575129828,
      "created": 1789574977098,
      "link": null,
      "locked": false,
      "text": "*** Local Storage: Use localStorage for simple client-side persistence.\nPros:\n- Easy to implement.\n- Works without authentication.\n- Good for local device preference.\nCons:\n- Does not sync across devices.\n- Not available during server rendering.\n- Can cause flash of wrong theme unless handled early.\n========================================================================\n\n*** Cookie: Use cookies when server-rendered HTML needs the correct initial theme.\nPros:\n- Available on the server.\n- Helps prevent initial theme mismatch.\n- Useful for SSR and edge rendering.\nCons:\n- Adds request overhead.\n- Requires cookie management.\n- Still device/browser specific unless synced to account settings.\n===========================================================================\n\n*** User Profile / Backend Setting: Use a backend setting when the preference should sync across devices.\nPros:\n- Cross-device consistency.\n- Useful for authenticated enterprise products.\n- Can be managed as part of user settings.\nCons:\n- Requires API integration.\n- Need optimistic update and failure handling.\n- Must define fallback behavior before user profile loads.\n================================================================================\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Local Storage: Use localStorage for simple client-side persistence.\nPros:\n- Easy to implement.\n- Works without authentication.\n- Good for local device preference.\nCons:\n- Does not sync across devices.\n- Not available during server rendering.\n- Can cause flash of wrong theme unless handled early.\n========================================================================\n\n*** Cookie: Use cookies when server-rendered HTML needs the correct initial theme.\nPros:\n- Available on the server.\n- Helps prevent initial theme mismatch.\n- Useful for SSR and edge rendering.\nCons:\n- Adds request overhead.\n- Requires cookie management.\n- Still device/browser specific unless synced to account settings.\n===========================================================================\n\n*** User Profile / Backend Setting: Use a backend setting when the preference should sync across devices.\nPros:\n- Cross-device consistency.\n- Useful for authenticated enterprise products.\n- Can be managed as part of user settings.\nCons:\n- Requires API integration.\n- Need optimistic update and failure handling.\n- Must define fallback behavior before user profile loads.\n================================================================================\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cqv2-_JW0wZtOp-g5X5X9",
      "type": "text",
      "x": 1709.0968149172295,
      "y": 2646.6144352763995,
      "width": 701.0594482421875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 807536608,
      "version": 120,
      "versionNonce": 1584478752,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789575126204,
      "created": 1789575107239,
      "link": null,
      "locked": false,
      "text": "Recommended Approach -- For a large authenticated product:\n\n- Use local storage for fast boot.\n- Use cookie for SSR correctness if needed.\n- Sync with backend user settings after login.\n- Prefer local value during initial render, then reconcile with server value.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recommended Approach -- For a large authenticated product:\n\n- Use local storage for fast boot.\n- Use cookie for SSR correctness if needed.\n- Sync with backend user settings after login.\n- Prefer local value during initial render, then reconcile with server value.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
