    },
    {
      "id": "zAnA678YrhHGNBQ4RqnsB",
      "type": "text",
      "x": 847.6740961710834,
      "y": 1976.7681978085222,
      "width": 1075.9791259765625,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 622301728,
      "version": 311,
      "versionNonce": 1127914016,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789574603528,
      "created": 1789574535179,
      "link": null,
      "locked": false,
      "text": "- This happen when page render before JS reads the stored preference\n- To prevent this, we could add inline scripts in HTML document before the app bundle load\n- For server-rended app, the preference can also be stored in cookie so the server render correct initial theme\n\n<script>\n  (function () {\n    try {\n      var preference = localStorage.getItem('app.theme.preference') || 'system';\n      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n      var resolvedTheme = preference === 'system' ? (prefersDark ? 'dark' : 'light') : preference;\n\n      document.documentElement.dataset.theme = resolvedTheme;\n      document.documentElement.style.colorScheme = resolvedTheme;\n    } catch (error) {\n      document.documentElement.dataset.theme = 'light';\n      document.documentElement.style.colorScheme = 'light';\n    }\n  })();\n</script>\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- This happen when page render before JS reads the stored preference\n- To prevent this, we could add inline scripts in HTML document before the app bundle load\n- For server-rended app, the preference can also be stored in cookie so the server render correct initial theme\n\n<script>\n  (function () {\n    try {\n      var preference = localStorage.getItem('app.theme.preference') || 'system';\n      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n      var resolvedTheme = preference === 'system' ? (prefersDark ? 'dark' : 'light') : preference;\n\n      document.documentElement.dataset.theme = resolvedTheme;\n      document.documentElement.style.colorScheme = resolvedTheme;\n    } catch (error) {\n      document.documentElement.dataset.theme = 'light';\n      document.documentElement.style.colorScheme = 'light';\n    }\n  })();\n</script>\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
