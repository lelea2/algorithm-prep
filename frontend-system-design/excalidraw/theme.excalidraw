    {
      "id": "fj6oBuIx93rMdxmjHzCf0",
      "type": "text",
      "x": 1480.1309082251087,
      "y": -361.7869718095671,
      "width": 609.5596313476562,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 389809696,
      "version": 448,
      "versionNonce": 1661733856,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789576079049,
      "created": 1789575868979,
      "link": null,
      "locked": false,
      "text": "1) CSS variables:\nPros: Native, fast, work with plain CSS, easy runtime switching\nCons: Harder to type-check token names\n2) Css-inJs theme object\nPros: strong JS integration, can be typed\nCons: More runtime overhead, harder for non-react surface\n3) Build-time generated tokens\nPros: consistent, can sync with design tools\nCons: Require token pipeline and tooling investment",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) CSS variables:\nPros: Native, fast, work with plain CSS, easy runtime switching\nCons: Harder to type-check token names\n2) Css-inJs theme object\nPros: strong JS integration, can be typed\nCons: More runtime overhead, harder for non-react surface\n3) Build-time generated tokens\nPros: consistent, can sync with design tools\nCons: Require token pipeline and tooling investment",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "06vNNGmZTI-0XGObxHGOO",
      "type": "text",
      "x": 1725.166876946383,
      "y": 2878.360372945866,
      "width": 641.0994873046875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 859902496,
      "version": 384,
      "versionNonce": 1092303840,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789576177845,
      "created": 1789576093295,
      "link": null,
      "locked": false,
      "text": "- LocalStorage: fast, simple, work anonymously, but does not sync\nacross device\n- Cookies: Good for SSR but more complex\n- BE settings: cross device sync, require API and reconcilation\n\n===>>>\n* LocalStorage for immediate boot\n* BE settings for authenticated sync\n* Cookie if SSR need correct first paint",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- LocalStorage: fast, simple, work anonymously, but does not sync\nacross device\n- Cookies: Good for SSR but more complex\n- BE settings: cross device sync, require API and reconcilation\n\n===>>>\n* LocalStorage for immediate boot\n* BE settings for authenticated sync\n* Cookie if SSR need correct first paint",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "PvVW0w0Trq6agvHoy5urT",
      "type": "text",
      "x": 137.54055552299457,
      "y": 5044.860664747597,
      "width": 388.57989501953125,
      "height": 25,
      "angle": 0,
