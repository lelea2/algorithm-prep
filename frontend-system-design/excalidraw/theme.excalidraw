      "link": null,
      "locked": false,
      "text": "*** CODE FOR THEME SETTINGS ***",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** CODE FOR THEME SETTINGS ***",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BmRwtIw1KvFPpvuUSrfD_",
      "type": "text",
      "x": 138.59417900502075,
      "y": 5096.738242581551,
      "width": 539.03955078125,
      "height": 620,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
      "roundness": null,
      "seed": 806014944,
      "version": 77,
      "versionNonce": 1839761376,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789576229447,
      "created": 1789576220704,
      "link": null,
      "locked": false,
      "text": "import { useTheme, ThemePreference } from './ThemeProvider';\n\nconst OPTIONS: Array<{ label: string; value: ThemePreference }> = [\n  { label: 'Light', value: 'light' },\n  { label: 'Dark', value: 'dark' },\n  { label: 'System', value: 'system' },\n];\n\nexport function ThemeSettings() {\n  const { preference, resolvedTheme, setPreference } = useTheme();\n\n  return (\n    <fieldset>\n      <legend>Appearance</legend>\n      <p>Current theme: {resolvedTheme}</p>\n\n      {OPTIONS.map((option) => (\n        <label key={option.value}>\n          <input\n            type=\"radio\"\n            name=\"theme\"\n            value={option.value}\n            checked={preference === option.value}\n            onChange={() => setPreference(option.value)}\n          />\n          {option.label}\n        </label>\n      ))}\n    </fieldset>\n  );\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import { useTheme, ThemePreference } from './ThemeProvider';\n\nconst OPTIONS: Array<{ label: string; value: ThemePreference }> = [\n  { label: 'Light', value: 'light' },\n  { label: 'Dark', value: 'dark' },\n  { label: 'System', value: 'system' },\n];\n\nexport function ThemeSettings() {\n  const { preference, resolvedTheme, setPreference } = useTheme();\n\n  return (\n    <fieldset>\n      <legend>Appearance</legend>\n      <p>Current theme: {resolvedTheme}</p>\n\n      {OPTIONS.map((option) => (\n        <label key={option.value}>\n          <input\n            type=\"radio\"\n            name=\"theme\"\n            value={option.value}\n            checked={preference === option.value}\n            onChange={() => setPreference(option.value)}\n          />\n          {option.label}\n        </label>\n      ))}\n    </fieldset>\n  );\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
