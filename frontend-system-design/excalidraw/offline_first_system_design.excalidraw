      "updated": 1791562726575,
      "created": 1791562706864,
      "link": null,
      "locked": false,
      "text": "POST /api/sync/mutations\nContent-Type: application/json\n{\n  \"operations\": [\n    {\n      \"operationId\": \"op-123\",\n      \"entityId\": \"task-456\",\n      \"type\": \"UPDATE\",\n      \"baseVersion\": 8,\n      \"changes\": {\n        \"completed\": true\n      }\n    }\n  ]\n}\n\nResponse\n{\n  \"results\": [\n    {\n      \"operationId\": \"op-123\",\n      \"status\": \"applied\",\n      \"entityId\": \"task-456\",\n      \"serverVersion\": 9\n    }\n  ]\n}\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /api/sync/mutations\nContent-Type: application/json\n{\n  \"operations\": [\n    {\n      \"operationId\": \"op-123\",\n      \"entityId\": \"task-456\",\n      \"type\": \"UPDATE\",\n      \"baseVersion\": 8,\n      \"changes\": {\n        \"completed\": true\n      }\n    }\n  ]\n}\n\nResponse\n{\n  \"results\": [\n    {\n      \"operationId\": \"op-123\",\n      \"status\": \"applied\",\n      \"entityId\": \"task-456\",\n      \"serverVersion\": 9\n    }\n  ]\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
