      "text": "App\n│\n├── OfflineProvider\n│   ├── DatabaseProvider\n│   ├── SyncProvider\n│   └── ConnectivityProvider\n│\n├── AppShell\n│   ├── ConnectivityBanner\n│   ├── SyncStatusIndicator\n│   └── RecoveryCenter\n│\n├── ProjectPage\n│   ├── ProjectHeader\n│   ├── TaskList\n│   │   └── TaskRow\n│   └── TaskEditor\n│\n└── ConflictResolutionDialog\n    ├── LocalVersion\n    ├── ServerVersion\n    └── MergeControls",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "App\n│\n├── OfflineProvider\n│   ├── DatabaseProvider\n│   ├── SyncProvider\n│   └── ConnectivityProvider\n│\n├── AppShell\n│   ├── ConnectivityBanner\n│   ├── SyncStatusIndicator\n│   └── RecoveryCenter\n│\n├── ProjectPage\n│   ├── ProjectHeader\n│   ├── TaskList\n│   │   └── TaskRow\n│   └── TaskEditor\n│\n└── ConflictResolutionDialog\n    ├── LocalVersion\n    ├── ServerVersion\n    └── MergeControls",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
