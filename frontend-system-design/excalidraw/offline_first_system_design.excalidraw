      "updated": 1791560106257,
      "created": 1791559950563,
      "link": null,
      "locked": false,
      "text": "type OperationType =\n  | \"CREATE\"\n  | \"UPDATE\"\n  | \"DELETE\";\n\ntype OperationStatus =\n  | \"pending\"\n  | \"inflight\"\n  | \"conflict\"\n  | \"failed\";\n\ninterface PendingOperation {\n  id: string;\n\n  entityType: \"task\" | \"project\";\n\n  entityId: string;\n\n  type: OperationType;\n\n  payload: Record<string, unknown>;\n\n  baseVersion: number | null;\n\n  createdAt: number;\n\n  attemptCount: number;\n\n  nextRetryAt?: number;\n\n  status: OperationStatus;\n\n  dependsOn?: string[];\n\n  lastError?: string;\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type OperationType =\n  | \"CREATE\"\n  | \"UPDATE\"\n  | \"DELETE\";\n\ntype OperationStatus =\n  | \"pending\"\n  | \"inflight\"\n  | \"conflict\"\n  | \"failed\";\n\ninterface PendingOperation {\n  id: string;\n\n  entityType: \"task\" | \"project\";\n\n  entityId: string;\n\n  type: OperationType;\n\n  payload: Record<string, unknown>;\n\n  baseVersion: number | null;\n\n  createdAt: number;\n\n  attemptCount: number;\n\n  nextRetryAt?: number;\n\n  status: OperationStatus;\n\n  dependsOn?: string[];\n\n  lastError?: string;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
