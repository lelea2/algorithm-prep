      "created": 1791564402492,
      "link": null,
      "locked": false,
      "text": "* Other tabs can invalidate their cached queries and reread IndexedDB.\n* BroadcastChannel notifications are hints, not the source of truth. They can\nbe missed when a tab is suspended or closed.\n* On focus or resume, tabs should refresh the relevant local database views.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Other tabs can invalidate their cached queries and reread IndexedDB.\n* BroadcastChannel notifications are hints, not the source of truth. They can be missed when a tab is suspended or closed.\n* On focus or resume, tabs should refresh the relevant local database views.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
