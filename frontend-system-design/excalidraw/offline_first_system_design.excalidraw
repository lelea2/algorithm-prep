    {
      "id": "oJJHaW9pYLPBLs4HuNqeT",
      "type": "text",
      "x": -289.97618642528175,
      "y": 8102.226421309082,
      "width": 1131.289114988358,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Z",
      "roundness": null,
      "seed": 1326562383,
      "version": 476,
      "versionNonce": 805274497,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791566548055,
      "created": 1791566426718,
      "link": null,
      "locked": false,
      "text": "A. User edits while synchronization is in progress ==> potential bug: apply old server snapshot that overwrite the\nchange ==> ack. handler must distinguish server-confirmed based from never pending local change\n\nServer confirm X ==> Advance confirmed server version ==> keep Y pending ==> rebase/reply Y if necessary ==>\ndisplay latest local intent",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. User edits while synchronization is in progress ==> potential bug: apply old server snapshot that overwrite the change ==> ack. handler must distinguish server-confirmed based from never pending local change\n\nServer confirm X ==> Advance confirmed server version ==> keep Y pending ==> rebase/reply Y if necessary ==> display latest local intent",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "TolU82n_S71UMhnFpBL4h",
      "type": "text",
      "x": -288.5108625813856,
      "y": 8254.620101074279,
      "width": 800,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1a",
      "roundness": null,
      "seed": 284260687,
      "version": 213,
      "versionNonce": 1208849743,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791566631673,
      "created": 1791566556926,
      "link": null,
      "locked": false,
      "text": "B. Delete vs update:\n\n* Delete wins.\n* Update restores the task.\n* Manual conflict resolution.\n* Server-defined domain rule.\n==> Delete item should not reappear because old update arrived\nIn task manager, preserve deletion as tombstone and surface conflict edit for\nrecovery",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "B. Delete vs update:\n\n* Delete wins.\n* Update restores the task.\n* Manual conflict resolution.\n* Server-defined domain rule.\n==> Delete item should not reappear because old update arrived\nIn task manager, preserve deletion as tombstone and surface conflict edit for recovery",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vvbVKuHp3zirjn0Hzz5CO",
      "type": "text",
      "x": -287.04553873748955,
      "y": 8500.794506848826,
      "width": 674.8594970703125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
