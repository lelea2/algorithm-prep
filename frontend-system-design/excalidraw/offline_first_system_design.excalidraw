    },
    {
      "id": "TwMHEFtTl8f8IXgpC7ypU",
      "type": "text",
      "x": 25.007512529814676,
      "y": 540.7171368210777,
      "width": 256.73980712890625,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 1229554543,
      "version": 75,
      "versionNonce": 1943387375,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791559675558,
      "created": 1791559668932,
      "link": null,
      "locked": false,
      "text": "type SyncStatus =\n  | \"synced\"\n  | \"pending\"\n  | \"syncing\"\n  | \"conflict\"\n  | \"error\";\n\ninterface Task {\n  id: string;\n  projectId: string;\n\n  title: string;\n  description: string;\n  completed: boolean;\n\n  version: number;\n\n  updatedAt: string;\n\n  syncStatus: SyncStatus;\n\n  deleted?: boolean;\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type SyncStatus =\n  | \"synced\"\n  | \"pending\"\n  | \"syncing\"\n  | \"conflict\"\n  | \"error\";\n\ninterface Task {\n  id: string;\n  projectId: string;\n\n  title: string;\n  description: string;\n  completed: boolean;\n\n  version: number;\n\n  updatedAt: string;\n\n  syncStatus: SyncStatus;\n\n  deleted?: boolean;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "K-yR-oWemXxe9qAVk6hvU",
      "type": "text",
