      "isDeleted": false,
      "boundElements": null,
      "updated": 1791566142765,
      "created": 1791563106230,
      "link": null,
      "locked": false,
      "text": "POST /api/sync/mutations\n\ninterface PushRequest {\n  clientId: string;\n  operations: PendingOperation[];\n}\n\ninterface PushResponse {\n  results: Array<{\n    operationId: string;\n    status:\n      | \"applied\"\n      | \"conflict\"\n      | \"rejected\";\n    serverVersion?: number;\n    authoritativeEntity?: Task;\n    errorCode?: string;\n  }>;\n}\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /api/sync/mutations\n\ninterface PushRequest {\n  clientId: string;\n  operations: PendingOperation[];\n}\n\ninterface PushResponse {\n  results: Array<{\n    operationId: string;\n    status:\n      | \"applied\"\n      | \"conflict\"\n      | \"rejected\";\n    serverVersion?: number;\n    authoritativeEntity?: Task;\n    errorCode?: string;\n  }>;\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ai6rEWJdnw5z9Pcz9s5LI",
      "type": "text",
