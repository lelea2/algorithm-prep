      "link": null,
      "locked": false,
      "text": "9) Storage Quota and Large Datasets",
      "fontSize": 27.239615616249655,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "9) Storage Quota and Large Datasets",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xcls_LvzO0cg_G8XueHhO",
      "type": "text",
      "x": -310.0346321559681,
      "y": 6512.03923140699,
      "width": 355.75970458984375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1M",
      "roundness": null,
      "seed": 1519984833,
      "version": 3,
      "versionNonce": 222733441,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791564973462,
      "created": 1791564972755,
      "link": null,
      "locked": false,
      "text": "IndexedDB performance depends on:\n\n* Index design.\n* Query shape.\n* Record size.\n* Transaction size.\n* Serialization costs.\n* Write amplification.\n* Device constraints.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IndexedDB performance depends on:\n\n* Index design.\n* Query shape.\n* Record size.\n* Transaction size.\n* Serialization costs.\n* Write amplification.\n* Device constraints.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "MYUE-2JapejWXXeXM3IU8",
      "type": "text",
      "x": 278.60852082426334,
      "y": 6480.57929363117,
      "width": 754.1394653320312,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1N",
      "roundness": null,
      "seed": 1311109025,
      "version": 44,
      "versionNonce": 403043841,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791564994365,
      "created": 1791564989401,
      "link": null,
      "locked": false,
      "text": "Use navigator.storage.estimate() for approximate quota and usage reporting.\n\nFor large data:\n\n* Synchronize in bounded batches.\n* Index frequent queries.\n* Stream or paginate reads.\n* Avoid loading entire stores.\n* Compact acknowledged operations.\n* Garbage-collect old tombstones only after safe synchronization.\n* Avoid storing unnecessary duplicate copies of attachments.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use navigator.storage.estimate() for approximate quota and usage reporting.\n\nFor large data:\n\n* Synchronize in bounded batches.\n* Index frequent queries.\n* Stream or paginate reads.\n* Avoid loading entire stores.\n* Compact acknowledged operations.\n* Garbage-collect old tombstones only after safe synchronization.\n* Avoid storing unnecessary duplicate copies of attachments.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
