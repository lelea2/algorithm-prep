      "boundElements": null,
      "updated": 1791563507768,
      "created": 1791563502651,
      "link": null,
      "locked": false,
      "text": "Reconnection triggers\n\n* Browser online event.\n* Application startup.\n* Tab becoming visible.\n* Successful authenticated request.\n* Explicit user retry.\n* Periodic scheduled retry.\n* Service Worker background sync, when available.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconnection triggers\n\n* Browser online event.\n* Application startup.\n* Tab becoming visible.\n* Successful authenticated request.\n* Explicit user retry.\n* Periodic scheduled retry.\n* Service Worker background sync, when available.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "6VbFsRbY9Qx3ARltRFm07",
      "type": "text",
      "x": 92.21985999941808,
      "y": 3943.575562410253,
      "width": 447.6797790527344,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 729206127,
      "version": 62,
      "versionNonce": 752735599,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791563540089,
      "created": 1791563511729,
      "link": null,
      "locked": false,
      "text": "Retry policy -- use exponential backoff\neg: 1s → 2s → 4s → 8s → 16s → 32s → 60s\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Retry policy -- use exponential backoff\neg: 1s → 2s → 4s → 8s → 16s → 32s → 60s\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
