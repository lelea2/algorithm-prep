    {
      "id": "2o6CZcNbW8-U2oso-Mj9y",
      "type": "text",
      "x": -305.3147196316801,
      "y": 6899.07205839861,
      "width": 274.6798095703125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Q",
      "roundness": null,
      "seed": 466906785,
      "version": 3,
      "versionNonce": 1219492449,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791565221241,
      "created": 1791565220656,
      "link": null,
      "locked": false,
      "text": "type GlobalSyncStatus =\n  | \"offline\"\n  | \"syncing\"\n  | \"upToDate\"\n  | \"pending\"\n  | \"conflicts\"\n  | \"error\"\n  | \"authenticationRequired\";",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type GlobalSyncStatus =\n  | \"offline\"\n  | \"syncing\"\n  | \"upToDate\"\n  | \"pending\"\n  | \"conflicts\"\n  | \"error\"\n  | \"authenticationRequired\";",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "v92VTh4_IFOa6aO8RXj7O",
      "type": "text",
      "x": 163.3947186200645,
      "y": 6907.024619344481,
      "width": 601.2794189453125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1R",
      "roundness": null,
      "seed": 687016111,
      "version": 20,
      "versionNonce": 417643855,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791565262998,
      "created": 1791565255161,
      "link": null,
      "locked": false,
      "text": "Critical UX principles: Never silently discard unsynced changes.\n\nProvide:\n* Retry sync.\n* Manual conflict resolution.\n* Copy/export local data.\n* Visibility into pending changes.\n* Explicit status for permanently rejected mutations.\n* Guidance when login is required.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Critical UX principles: Never silently discard unsynced changes.\n\nProvide:\n* Retry sync.\n* Manual conflict resolution.\n* Copy/export local data.\n* Visibility into pending changes.\n* Explicit status for permanently rejected mutations.\n* Guidance when login is required.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Gl5deunDvhXt21SV8yMz3",
      "type": "text",
      "x": 161.9566202728205,
      "y": 7177.546897331596,
      "width": 773.53955078125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1S",
