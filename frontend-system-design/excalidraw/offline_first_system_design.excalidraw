      "boundElements": null,
      "updated": 1791561020557,
      "created": 1791560984548,
      "link": null,
      "locked": false,
      "text": " Principle: local first does not mean memory-first, indexedDB remain durable\nsource and react only holds the state needed for active UI",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Principle: local first does not mean memory-first, indexedDB remain durable source and react only holds the state needed for active UI",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "saVq_jWSNIgsBRb3ZghPu",
      "type": "text",
      "x": 1101.1969738266823,
      "y": 1689.6764392096513,
      "width": 615.3595581054688,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 1433837647,
      "version": 3,
      "versionNonce": 1467488399,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791561031451,
      "created": 1791561030578,
      "link": null,
      "locked": false,
      "text": "* Load only the current page or viewport.\n* Use indexed queries.\n* Virtualize long lists.\n* Avoid deserializing the complete database.\n* Memoize row components where useful.\n* Keep network and database operations outside render paths.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Load only the current page or viewport.\n* Use indexed queries.\n* Virtualize long lists.\n* Avoid deserializing the complete database.\n* Memoize row components where useful.\n* Keep network and database operations outside render paths.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
