      "updated": 1791560939519,
      "created": 1791560667073,
      "link": null,
      "locked": false,
      "text": "import { useSyncExternalStore } from \"react\";\n\nfunction useTasks(store: TaskStore) {\n  return useSyncExternalStore(\n    store.subscribe,\n    store.getSnapshot, // return cached, stable reference when data not change\n    store.getSnapshot\n  );\n}\n\n// useSyncExternalStore: components to subscribe to external data stores\noutside of the React ecosystem while remaining fully compatible with concurrent\nrendering features like transitions and suspense.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import { useSyncExternalStore } from \"react\";\n\nfunction useTasks(store: TaskStore) {\n  return useSyncExternalStore(\n    store.subscribe,\n    store.getSnapshot, // return cached, stable reference when data not change\n    store.getSnapshot\n  );\n}\n\n// useSyncExternalStore: components to subscribe to external data stores outside of the React ecosystem while remaining fully compatible with concurrent rendering features like transitions and suspense.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
