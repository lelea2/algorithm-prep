    {
      "id": "44IEg_1Y9YOyca12A4T9-",
      "type": "text",
      "x": 102.06952641603459,
      "y": 2715.845398279704,
      "width": 425.24761962890625,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1982029185,
      "version": 32,
      "versionNonce": 368263521,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791562209046,
      "created": 1791562203186,
      "link": null,
      "locked": false,
      "text": "class SyncEngine {\n  private running = false;\n\n  async flushQueue() {\n    if (this.running) return;\n\n    this.running = true;\n\n    try {\n      while (await this.isServerReachable()) {\n        const operations =\n          await this.repository.getReadyOperations();\n\n        if (operations.length === 0) {\n          break;\n        }\n\n        const batch =\n          this.selectIndependentOperations(operations);\n\n        await this.processBatch(batch);\n      }\n    } finally {\n      this.running = false;\n    }\n  }\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class SyncEngine {\n  private running = false;\n\n  async flushQueue() {\n    if (this.running) return;\n\n    this.running = true;\n\n    try {\n      while (await this.isServerReachable()) {\n        const operations =\n          await this.repository.getReadyOperations();\n\n        if (operations.length === 0) {\n          break;\n        }\n\n        const batch =\n          this.selectIndependentOperations(operations);\n\n        await this.processBatch(batch);\n      }\n    } finally {\n      this.running = false;\n    }\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
