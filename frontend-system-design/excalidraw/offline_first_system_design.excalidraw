      "link": null,
      "locked": false,
      "text": "11) Security, Observability & Debuggability",
      "fontSize": 28.02264804533117,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "11) Security, Observability & Debuggability",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Mm0isol52_-wMI2912tiN",
      "type": "text",
      "x": -302.61058709057147,
      "y": 7482.156912623643,
      "width": 906.6355365731813,
      "height": 481.65012880450263,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 197821359,
      "version": 49,
      "versionNonce": 1041486991,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791565860967,
      "created": 1791565812966,
      "link": null,
      "locked": false,
      "text": "Important security distinction: Client-side encryption may protect some data-at-\nrest scenarios, but it does not automatically defend against XSS when the\nactive application can decrypt the same data.\n\nEncryption requires deliberate key management: For highly sensitive applications,\ndetermine whether offline storage is permitted at all.\n\nWhat happens to unsynchronized edits when a user logs out?\n\nPossible product policy:\n1. Warn about pending changes.\n2. Attempt synchronization.\n3. Offer an explicit export where permitted.\n4. Prevent cross-account access to the old workspace.\n5. Apply the organization’s data retention/security policy.\n\nDo not silently delete valuable work without an intentional, communicated policy.",
      "fontSize": 22.665888414329544,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Important security distinction: Client-side encryption may protect some data-at-rest scenarios, but it does not automatically defend against XSS when the active application can decrypt the same data.\n\nEncryption requires deliberate key management: For highly sensitive applications, determine whether offline storage is permitted at all.\n\nWhat happens to unsynchronized edits when a user logs out?\n\nPossible product policy:\n1. Warn about pending changes.\n2. Attempt synchronization.\n3. Offer an explicit export where permitted.\n4. Prevent cross-account access to the old workspace.\n5. Apply the organization’s data retention/security policy.\n\nDo not silently delete valuable work without an intentional, communicated policy.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HxxkBj2IwHWaSWgoCtJC8",
      "type": "text",
      "x": 855.4636634955365,
      "y": 7467.549678669744,
      "width": 800,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1V",
      "roundness": null,
      "seed": 1282492257,
      "version": 27,
      "versionNonce": 243703599,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791566007886,
      "created": 1791565979284,
      "link": null,
      "locked": false,
      "text": "Observability:\n\nUser command\n    ↓\nIndexedDB queue entry\n    ↓\nSync attempt\n    ↓\nHTTP request\n    ↓\nServer mutation\n    ↓\nAcknowledgment",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observability:\n\nUser command\n    ↓\nIndexedDB queue entry\n    ↓\nSync attempt\n    ↓\nHTTP request\n    ↓\nServer mutation\n    ↓\nAcknowledgment",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ANXWlDDy1Xvi9_MhGHVxF",
      "type": "text",
      "x": 1263.1297139942385,
      "y": 7455.27449638642,
      "width": 251.5797882080078,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1W",
      "roundness": null,
      "seed": 956772335,
      "version": 366,
      "versionNonce": 272550881,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791566101672,
      "created": 1791566022453,
      "link": null,
      "locked": false,
      "text": "Metrics:\n\n- sync_queue_depth\n- sync_lag_second\n- sync_attempt_failures\n- conflict_rate\n- retry_count\n- idb_transaction_latency\n- idb_transaction_failure\n- checkpoint_age\n- storage_usage_ratio\n- sync_recovery_duration",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Metrics:\n\n- sync_queue_depth\n- sync_lag_second\n- sync_attempt_failures\n- conflict_rate\n- retry_count\n- idb_transaction_latency\n- idb_transaction_failure\n- checkpoint_age\n- storage_usage_ratio\n- sync_recovery_duration",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
