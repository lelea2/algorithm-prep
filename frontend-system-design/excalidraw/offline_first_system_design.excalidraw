      "version": 82,
      "versionNonce": 204428783,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791565289323,
      "created": 1791565271631,
      "link": null,
      "locked": false,
      "text": "*** NEVER show green SAVED merely because React state update, distinguish:\nEditing...\nSaved on this device\nWaiting to sync\nSyncing...\nSynced across devices\nAction required",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** NEVER show green SAVED merely because React state update, distinguish:\nEditing...\nSaved on this device\nWaiting to sync\nSyncing...\nSynced across devices\nAction required",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "QSB75o_3Cdfo6GNJdlCWf",
