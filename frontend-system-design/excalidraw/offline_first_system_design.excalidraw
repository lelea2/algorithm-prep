    {
      "id": "631oQdW0IlSpo2wB3WfEi",
      "type": "text",
      "x": 1434.1813357298302,
      "y": 3341.619667990559,
      "width": 323.43975830078125,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
