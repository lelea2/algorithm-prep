      "updated": 1791560549946,
      "created": 1791560162728,
      "link": null,
      "locked": false,
      "text": "* TaskListEditor: collect input/issue commands\n* TaskList: render reactive local query results\n* TaskRepository: encapsulate IndexDB entity operation\n* Sync Engine: send queue operation and fetch remote changes\n* Conflict resolver: apply merge policies and request user resolution\n* ConnectivityManager: track network reachability signale\n* SyncCoordinator: coordinate synchronization across browser tabs\n* Recovery center: surface failed and unresolved changes\n* DatabaseMigrationManager: upgrade local IndexDB schema safely",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* TaskListEditor: collect input/issue commands\n* TaskList: render reactive local query results\n* TaskRepository: encapsulate IndexDB entity operation\n* Sync Engine: send queue operation and fetch remote changes\n* Conflict resolver: apply merge policies and request user resolution\n* ConnectivityManager: track network reachability signale\n* SyncCoordinator: coordinate synchronization across browser tabs\n* Recovery center: surface failed and unresolved changes\n* DatabaseMigrationManager: upgrade local IndexDB schema safely",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
