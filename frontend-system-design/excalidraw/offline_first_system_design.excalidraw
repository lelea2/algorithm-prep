      "boundElements": null,
      "updated": 1791564365754,
      "created": 1791564362813,
      "link": null,
      "locked": false,
      "text": "async function runWithSyncLock(\n  sync: () => Promise<void>\n) {\n  await navigator.locks.request(\n    \"offline-sync\",\n    async () => {\n      await sync();\n    }\n  );\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async function runWithSyncLock(\n  sync: () => Promise<void>\n) {\n  await navigator.locks.request(\n    \"offline-sync\",\n    async () => {\n      await sync();\n    }\n  );\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
