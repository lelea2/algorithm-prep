      "created": 1791563135325,
      "link": null,
      "locked": false,
      "text": "** Pull endpoint\nGET /api/sync/changes?cursor=abc123&limit=500\n\ninterface PullResponse {\n  changes: Array<{\n    entityId: string;\n    type: \"UPSERT\" | \"DELETE\";\n    entity?: Task;\n    version: number;\n  }>;\n  nextCursor: string;\n  hasMore: boolean;\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** Pull endpoint\nGET /api/sync/changes?cursor=abc123&limit=500\n\ninterface PullResponse {\n  changes: Array<{\n    entityId: string;\n    type: \"UPSERT\" | \"DELETE\";\n    entity?: Task;\n    version: number;\n  }>;\n  nextCursor: string;\n  hasMore: boolean;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
