    {
      "id": "EerI84M9RuaOoZioU6BcX",
      "type": "text",
      "x": 375.96875,
      "y": 575.65234375,
      "width": 263.59979248046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
