    {
      "id": "0clKQoioHZDUXm3tRToKD",
      "type": "text",
      "x": 1075.7506945491352,
      "y": 3796.0468693842163,
      "width": 508.0595703125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
