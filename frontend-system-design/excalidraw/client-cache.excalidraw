    {
      "id": "sIZ8t1lKlBYLKPtk0iVvy",
      "type": "text",
      "x": 1782.8543560301641,
      "y": 2111.5442088174623,
      "width": 760.0595703125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0R",
