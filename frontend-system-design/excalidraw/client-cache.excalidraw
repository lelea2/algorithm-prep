    },
    {
      "id": "lkdrIykqPG09s_PE5D47E",
      "type": "text",
      "x": 378.12109375,
      "y": 192.62109375,
      "width": 571.6308369407652,
      "height": 303.78125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 899762161,
      "version": 45,
      "versionNonce": 220163089,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787346875760,
      "link": null,
      "locked": false,
      "text": "* Read data from server through a client SDK.\n* Cache successful GET/query results in browser memory.\n* Use a deterministic cache key including filters, pagination, tenant/user scope, locale, etc.\n* Return fresh cached data without making another network request.\n* Support TTL / stale time.\n* Support stale-while-revalidate.\n* Deduplicate concurrent identical requests with an in-flight request map.\n* Support filtered-list caching.\n* Normalize entities when useful, e.g. User:123 stored once and lists reference IDs.\n* Support mutations: create, update, delete.\n* Update or invalidate affected cache entries after mutations.\n* Support optimistic updates with rollback on failure.\n* Prevent stale network responses from overwriting newer mutations using versions/generations.\n* Support manual invalidation by key, prefix, or tag.\n* Support background refetch.\n* Optionally persist selected cache entries to IndexedDB.\n* Support cross-tab invalidation with BroadcastChannel.\n* Work with browser HTTP caching via Cache-Control / ETag.\n* Expose subscription hooks for React, e.g. useQuery, useMutation.\n* Support cancellation when requests are no longer needed.",
      "fontSize": 12.151250000000001,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Read data from server through a client SDK.\n* Cache successful GET/query results in browser memory.\n* Use a deterministic cache key including filters, pagination, tenant/user scope, locale, etc.\n* Return fresh cached data without making another network request.\n* Support TTL / stale time.\n* Support stale-while-revalidate.\n* Deduplicate concurrent identical requests with an in-flight request map.\n* Support filtered-list caching.\n* Normalize entities when useful, e.g. User:123 stored once and lists reference IDs.\n* Support mutations: create, update, delete.\n* Update or invalidate affected cache entries after mutations.\n* Support optimistic updates with rollback on failure.\n* Prevent stale network responses from overwriting newer mutations using versions/generations.\n* Support manual invalidation by key, prefix, or tag.\n* Support background refetch.\n* Optionally persist selected cache entries to IndexedDB.\n* Support cross-tab invalidation with BroadcastChannel.\n* Work with browser HTTP caching via Cache-Control / ETag.\n* Expose subscription hooks for React, e.g. useQuery, useMutation.\n* Support cancellation when requests are no longer needed.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
