      "seed": 557649423,
      "version": 554,
      "versionNonce": 1038975425,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787350826724,
      "link": null,
      "locked": false,
      "text": "*** For large list we could store query:\n\n- Store ListID [1, 2, 3, 4]\n- Store detail metadata: {\"1\": {}, \"2\": {}...}\n- In this case, on update, we only need to manipulate store details metadata,\nwhile the listID is unchanged\n\n\n*** 2 options for update\n- Reinvalidate cache (clear cache ) -> next call will fetch from server\n- fetch() in background update on server",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** For large list we could store query:\n\n- Store ListID [1, 2, 3, 4]\n- Store detail metadata: {\"1\": {}, \"2\": {}...}\n- In this case, on update, we only need to manipulate store details metadata,\nwhile the listID is unchanged\n\n\n*** 2 options for update\n- Reinvalidate cache (clear cache ) -> next call will fetch from server\n- fetch() in background update on server",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
