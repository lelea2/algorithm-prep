      "version": 181,
      "versionNonce": 1605014536,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789590793494,
      "created": 1789590770102,
      "link": null,
      "locked": false,
      "text": "type QueryOptions<T> = {\n  key: string;\n  fetcher: () => Promise<T>;\n  staleTime?: number;\n  policy?: FetchPolicy;\n};\n\nconst cache = new Map<string, CacheEntry<any>>();",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type QueryOptions<T> = {\n  key: string;\n  fetcher: () => Promise<T>;\n  staleTime?: number;\n  policy?: FetchPolicy;\n};\n\nconst cache = new Map<string, CacheEntry<any>>();",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WOP86fo_NdmtBW9vYUj7O",
      "type": "arrow",
