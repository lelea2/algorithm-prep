      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type CacheEntry<T> = {\n  data?: T;\n\n  status:\n    | \"idle\"\n    | \"loading\"\n    | \"success\"\n    | \"error\";\n\n  error?: Error;\n\n  updatedAt: number;\n\n  staleTime: number;\n\n  promise?: Promise<T>;\n};",
      "autoResize": true,
