      "updated": 1789590701425,
      "created": 1789590695222,
      "link": null,
      "locked": false,
      "text": "const paymentKeys = {\n  all: [\"payments\"] as const,\n\n  lists: () =>\n    [...paymentKeys.all, \"list\"] as const,\n\n  list: (filters: PaymentFilters) =>\n    [...paymentKeys.lists(), filters] as const,\n\n  detail: (id: string) =>\n    [...paymentKeys.all, \"detail\", id] as const,\n};",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const paymentKeys = {\n  all: [\"payments\"] as const,\n\n  lists: () =>\n    [...paymentKeys.all, \"list\"] as const,\n\n  list: (filters: PaymentFilters) =>\n    [...paymentKeys.lists(), filters] as const,\n\n  detail: (id: string) =>\n    [...paymentKeys.all, \"detail\", id] as const,\n};",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
