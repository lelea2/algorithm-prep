    {
      "id": "xmFF9gG1LhsCDcxNUYVCX",
      "type": "text",
      "x": 1069.1850800023474,
      "y": 1306.3398420528665,
      "width": 1238.6288603143298,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
