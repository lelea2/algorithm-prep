    {
      "id": "fh2NDSti33xDicVJfkEiX",
      "type": "text",
      "x": 1067.0198109991359,
      "y": 78.73352892534965,
      "width": 439.6797180175781,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1908724287,
      "version": 73,
      "versionNonce": 350754399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787349049097,
      "link": null,
      "locked": false,
      "text": "Request deduplication\n    = prevent simultaneous duplicate requests\n\nCache TTL\n    = prevent repeated requests over time\n\nETag\n    = make necessary revalidation cheap\n\nInvalidation\n    = maintain correctness after writes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Request deduplication\n    = prevent simultaneous duplicate requests\n\nCache TTL\n    = prevent repeated requests over time\n\nETag\n    = make necessary revalidation cheap\n\nInvalidation\n    = maintain correctness after writes",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
