      "updated": 1789590154898,
      "created": 1789590124993,
      "link": null,
      "locked": false,
      "text": "*** HANDLE CACHE CLIENT WITH REACT ***",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** HANDLE CACHE CLIENT WITH REACT ***",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NcfF8GU0a_1M3C9CeTZxX",
      "type": "text",
      "x": 121.95216432587199,
      "y": 4627.471081274463,
      "width": 662.1287812516115,
      "height": 601.9352556832832,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 1686429304,
      "version": 89,
      "versionNonce": 1455569528,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789590171040,
      "created": 1789590161162,
      "link": null,
      "locked": false,
      "text": "React Component\n      │\n      ▼\nuseQuery / useMutation\n      │\n      ▼\n┌───────────────────────────────┐\n│ Client Data Layer             │\n│                               │\n│ Query Cache                   │\n│ key → {data, status, metadata}│\n│                               │\n│ Mutation Manager              │\n│ optimistic update             │\n│ rollback                      │\n│ invalidation                  │\n└──────────────┬────────────────┘\n               │\n      ┌────────┴────────┐\n      ▼                 ▼\n Memory Cache        Network\n                         │\n                         ▼\n                       API",
      "fontSize": 20.064508522776087,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "React Component\n      │\n      ▼\nuseQuery / useMutation\n      │\n      ▼\n┌───────────────────────────────┐\n│ Client Data Layer             │\n│                               │\n│ Query Cache                   │\n│ key → {data, status, metadata}│\n│                               │\n│ Mutation Manager              │\n│ optimistic update             │\n│ rollback                      │\n│ invalidation                  │\n└──────────────┬────────────────┘\n               │\n      ┌────────┴────────┐\n      ▼                 ▼\n Memory Cache        Network\n                         │\n                         ▼\n                       API",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "dJ2YVn8a24j5Ggv2SJUAD",
      "type": "image",
      "x": 249.6321096107681,
      "y": 4408.861460063582,
      "width": 440.87075240503526,
      "height": 600.6494143504842,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 865709432,
      "version": 176,
      "versionNonce": 1069045000,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789590194369,
      "created": 1789590190812,
      "link": null,
      "locked": false,
      "status": "saved",
      "fileId": "682e96f09fa2c7d29b5949e72fd9d6f1e3324bb8",
      "scale": [
        1,
        1
      ],
      "crop": null
    },
    {
      "id": "YURnTIuXfDMmDKGRlXKfn",
      "type": "text",
      "x": 766.1311375901107,
      "y": 4428.789706751034,
      "width": 850.5794067382812,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 184652040,
      "version": 734,
      "versionNonce": 198846840,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789590497708,
      "created": 1789590285123,
      "link": null,
      "locked": false,
      "text": "\n* Cache-only:  never from network, good for offline/known preload data\n* Network-only: always network, update cache, highly dynamic data\n* cache-first: cache -> network only if missing, mostly for static data\n* cache-and-network: return cache immediately + fetch fresh. good for dashboard data\n* no-cache: network only, don't store, used for sensitive/one-off data\n* stale-while-validate: use cache if available, refresh is stale. Most use for app GETS\n\nBy default: stale-while-validate or cache-and-network\n\ntype FetchPolicy =\n  | \"cache-only\"\n  | \"network-only\"\n  | \"cache-first\"\n  | \"cache-and-network\"\n  | \"no-cache\";",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n* Cache-only:  never from network, good for offline/known preload data\n* Network-only: always network, update cache, highly dynamic data\n* cache-first: cache -> network only if missing, mostly for static data\n* cache-and-network: return cache immediately + fetch fresh. good for dashboard data\n* no-cache: network only, don't store, used for sensitive/one-off data\n* stale-while-validate: use cache if available, refresh is stale. Most use for app GETS\n\nBy default: stale-while-validate or cache-and-network\n\ntype FetchPolicy =\n  | \"cache-only\"\n  | \"network-only\"\n  | \"cache-first\"\n  | \"cache-and-network\"\n  | \"no-cache\";",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
