      "seed": 1995307937,
      "version": 76,
      "versionNonce": 1036336641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787351136003,
      "link": null,
      "locked": false,
      "text": "- Since it's synchronous, can be janky for large data\n\nJSON.stringify(largeObject)\n        +\nlocalStorage.setItem(...)\n        |\n        v\nmain thread blocked\n        |\n        v\npossible UI jank",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Since it's synchronous, can be janky for large data\n\nJSON.stringify(largeObject)\n        +\nlocalStorage.setItem(...)\n        |\n        v\nmain thread blocked\n        |\n        v\npossible UI jank",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "r0xFidCYZcVa3xDT5Z38u",
      "type": "text",
      "x": 1792.2330801512799,
      "y": 2466.9728750854965,
      "width": 807.3560390139289,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 1231720865,
      "version": 31,
      "versionNonce": 20388079,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787351174038,
      "link": null,
      "locked": false,
      "text": "*** If the mutation only changes display fields like name, patch the item in cached\nlists. If it changes fields used for filtering, sorting, pagination, or permissions,\ninvalidate the affected list queries and refetch them.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** If the mutation only changes display fields like name, patch the item in cached lists. If it changes fields used for filtering, sorting, pagination, or permissions, invalidate the affected list queries and refetch them.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "tO1hbevMXHkymvzI6fEIm",
      "type": "text",
      "x": 291.01760363454014,
      "y": 886.5785931943796,
      "width": 597.1795043945312,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Y",
      "roundness": null,
      "seed": 85436783,
      "version": 9,
      "versionNonce": 1322875567,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787351289775,
      "link": null,
      "locked": false,
      "text": "V1:\nquery-key cache + TTL + dedupe + invalidation\n\nV2:\nSWR + optimistic mutations + LRU\n\nV3:\nnormalized entity cache + IndexedDB + cross-tab sync\n\nV4:\nmore advanced dependency tracking / server push invalidation",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "V1:\nquery-key cache + TTL + dedupe + invalidation\n\nV2:\nSWR + optimistic mutations + LRU\n\nV3:\nnormalized entity cache + IndexedDB + cross-tab sync\n\nV4:\nmore advanced dependency tracking / server push invalidation",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
