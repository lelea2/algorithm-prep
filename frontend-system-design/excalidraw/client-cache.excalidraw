    {
      "id": "2MspjPbGDj0Qd4LBDJSmS",
      "type": "text",
      "x": 2068.555103170069,
      "y": 5223.657473551673,
      "width": 496.9276123046875,
      "height": 1520,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b13",
      "roundness": null,
      "seed": 459780360,
      "version": 50,
      "versionNonce": 393920008,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789590807564,
      "created": 1789590801515,
      "link": null,
      "locked": false,
      "text": "async function fetchQuery<T>({\n  key,\n  fetcher,\n  staleTime = 30_000,\n  policy = \"cache-first\",\n}: QueryOptions<T>): Promise<T> {\n\n  const cached = cache.get(key) as CacheEntry<T> | undefined;\n\n  const fresh =\n    cached &&\n    cached.data !== undefined &&\n    Date.now() - cached.updatedAt < staleTime;\n\n  if (policy === \"cache-only\") {\n    if (!cached?.data) {\n      throw new Error(\"Cache miss\");\n    }\n\n    return cached.data;\n  }\n\n  if (policy === \"cache-first\" && fresh) {\n    return cached.data!;\n  }\n\n  if (\n    policy === \"cache-and-network\" &&\n    cached?.data\n  ) {\n    void runNetworkRequest();\n\n    return cached.data;\n  }\n\n  if (cached?.promise) {\n    return cached.promise;\n  }\n\n  return runNetworkRequest();\n\n  function runNetworkRequest() {\n    const promise = fetcher()\n      .then(data => {\n        cache.set(key, {\n          data,\n          status: \"success\",\n          updatedAt: Date.now(),\n          staleTime,\n        });\n\n        return data;\n      })\n      .catch(error => {\n        cache.set(key, {\n          ...cached,\n          status: \"error\",\n          error,\n          updatedAt: cached?.updatedAt ?? 0,\n          staleTime,\n        });\n\n        throw error;\n      });\n\n    cache.set(key, {\n      ...cached,\n      status: \"loading\",\n      updatedAt: cached?.updatedAt ?? 0,\n      staleTime,\n      promise,\n    });\n\n    return promise;\n  }\n}",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async function fetchQuery<T>({\n  key,\n  fetcher,\n  staleTime = 30_000,\n  policy = \"cache-first\",\n}: QueryOptions<T>): Promise<T> {\n\n  const cached = cache.get(key) as CacheEntry<T> | undefined;\n\n  const fresh =\n    cached &&\n    cached.data !== undefined &&\n    Date.now() - cached.updatedAt < staleTime;\n\n  if (policy === \"cache-only\") {\n    if (!cached?.data) {\n      throw new Error(\"Cache miss\");\n    }\n\n    return cached.data;\n  }\n\n  if (policy === \"cache-first\" && fresh) {\n    return cached.data!;\n  }\n\n  if (\n    policy === \"cache-and-network\" &&\n    cached?.data\n  ) {\n    void runNetworkRequest();\n\n    return cached.data;\n  }\n\n  if (cached?.promise) {\n    return cached.promise;\n  }\n\n  return runNetworkRequest();\n\n  function runNetworkRequest() {\n    const promise = fetcher()\n      .then(data => {\n        cache.set(key, {\n          data,\n          status: \"success\",\n          updatedAt: Date.now(),\n          staleTime,\n        });\n\n        return data;\n      })\n      .catch(error => {\n        cache.set(key, {\n          ...cached,\n          status: \"error\",\n          error,\n          updatedAt: cached?.updatedAt ?? 0,\n          staleTime,\n        });\n\n        throw error;\n      });\n\n    cache.set(key, {\n      ...cached,\n      status: \"loading\",\n      updatedAt: cached?.updatedAt ?? 0,\n      staleTime,\n      promise,\n    });\n\n    return promise;\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
