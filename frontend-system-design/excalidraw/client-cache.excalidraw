      "updated": 1787349956979,
      "link": null,
      "locked": false,
      "text": "3) Store cache on GET vs UPDATE",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3) Store cache on GET vs UPDATE",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "v1VBd2eUGT_2kIHQH7mWs",
      "type": "text",
      "x": 1071.5902793316882,
      "y": 2054.3015052568126,
      "width": 450.8155822753906,
      "height": 1060,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 182961519,
      "version": 89,
      "versionNonce": 1827555713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787350009315,
      "link": null,
      "locked": false,
      "text": "const cache = new Map();\nconst inflight = new Map();\n\nconst TTL = 60_000;\n\nfunction keyForUsers(filters = {}) {\n  const params = new URLSearchParams();\n\n  Object.keys(filters)\n    .sort()\n    .forEach(key => params.set(key, String(filters[key])));\n\n  return `/users?${params.toString()}`;\n}\n\nasync function getUsers(filters = {}) {\n  const key = keyForUsers(filters);\n  const now = Date.now();\n\n  const cached = cache.get(key);\n\n  // 1. Fresh cache hit\n  if (cached && cached.expiresAt > now) {\n    return cached.data;\n  }\n\n  // 2. Deduplicate concurrent requests\n  if (inflight.has(key)) {\n    return inflight.get(key);\n  }\n\n  // 3. Fetch from server\n  const request = fetch(key)\n    .then(res => {\n      if (!res.ok) throw new Error(\"Failed to fetch users\");\n      return res.json();\n    })\n    .then(data => {\n      cache.set(key, {\n        data,\n        expiresAt: Date.now() + TTL,\n      });\n\n      return data;\n    })\n    .finally(() => {\n      inflight.delete(key);\n    });\n\n  inflight.set(key, request);\n\n  return request;\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const cache = new Map();\nconst inflight = new Map();\n\nconst TTL = 60_000;\n\nfunction keyForUsers(filters = {}) {\n  const params = new URLSearchParams();\n\n  Object.keys(filters)\n    .sort()\n    .forEach(key => params.set(key, String(filters[key])));\n\n  return `/users?${params.toString()}`;\n}\n\nasync function getUsers(filters = {}) {\n  const key = keyForUsers(filters);\n  const now = Date.now();\n\n  const cached = cache.get(key);\n\n  // 1. Fresh cache hit\n  if (cached && cached.expiresAt > now) {\n    return cached.data;\n  }\n\n  // 2. Deduplicate concurrent requests\n  if (inflight.has(key)) {\n    return inflight.get(key);\n  }\n\n  // 3. Fetch from server\n  const request = fetch(key)\n    .then(res => {\n      if (!res.ok) throw new Error(\"Failed to fetch users\");\n      return res.json();\n    })\n    .then(data => {\n      cache.set(key, {\n        data,\n        expiresAt: Date.now() + TTL,\n      });\n\n      return data;\n    })\n    .finally(() => {\n      inflight.delete(key);\n    });\n\n  inflight.set(key, request);\n\n  return request;\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
