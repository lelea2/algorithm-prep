      "updated": 1787349302696,
      "link": null,
      "locked": false,
      "text": "const updatedUser = await api.updateUser(id, patch);\n\nclient.set([\"user\", id], updatedUser);\n\nclient.invalidateQueries({\n  prefix: [\"users\"]\n});",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const updatedUser = await api.updateUser(id, patch);\n\nclient.set([\"user\", id], updatedUser);\n\nclient.invalidateQueries({\n  prefix: [\"users\"]\n});",
