      "updated": 1787438475533,
      "link": null,
      "locked": false,
      "text": "Non-functional requirements:\n\n1) Availability > scalability\n2) Low latency streaming\n3) High scale\n4) Support large video (10+ GB)\n5) Resumable uploads",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirements:\n\n1) Availability > scalability\n2) Low latency streaming\n3) High scale\n4) Support large video (10+ GB)\n5) Resumable uploads",
      "autoResize": true,
      "lineHeight": 1.25
    },
